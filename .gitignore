# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# awf dogfood: when running awf commands inside this repo (e.g. E2E tests,
# manual smoke tests), `.agentic/` gets created in cwd. Never commit it.
.agentic/

# BD-9/BD-12 write .bak files (config.yaml.bak, pipelines/default.yaml.bak)
# next to the originals. Project-level .gitignore covers them; this entry
# protects repos that don't ignore .agentic/ wholesale.
*.bak

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Skill artifacts
QA_REPORT.md
QA_AUDIT_REPORT.md
*_AUDIT.md
qa-audit-*.md
