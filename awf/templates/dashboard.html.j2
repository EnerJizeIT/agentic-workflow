{# Dashboard v2.1 — stable chat, chain visualization, polished design #}
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>awf · {{ project_name }} · {{ todo_id }}</title>
<style>
:root {
  --bg: #0d1117; --bg-card: #161b22; --bg-hover: #1c2128; --bg-deep: #010409;
  --text: #e6edf3; --text-muted: #8b949e; --text-dim: #484f58;
  --accent: #58a6ff; --green: #3fb950; --yellow: #d29922; --red: #f85149;
  --purple: #bc8cff; --orange: #db6d28; --cyan: #39c5cf;
  --border: #30363d; --border-subtle: #21262d;
  --radius: 10px; --radius-sm: 6px;
  --mono: 'SF Mono','JetBrains Mono','Cascadia Code',monospace;
  --shadow-sm: 0 1px 3px rgba(0,0,0,0.3);
  --shadow-md: 0 3px 12px rgba(0,0,0,0.4);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg-deep); color: var(--text); font-family: system-ui,-apple-system,'Segoe UI',sans-serif; font-size: 14px; height: 100vh; overflow: hidden; }

/* ─── Top bar ─── */
.topbar { display: flex; align-items: center; gap: 20px; padding: 10px 24px; background: var(--bg-card); border-bottom: 1px solid var(--border); box-shadow: var(--shadow-sm); z-index: 10; }
.topbar-project { font-size: 15px; font-weight: 600; white-space: nowrap; letter-spacing: -0.3px; }
.topbar-timeline { display: flex; align-items: center; gap: 4px; flex: 1; overflow-x: auto; scrollbar-width: thin; }
.topbar-timeline::-webkit-scrollbar { height: 3px; }
.todo-pill { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 20px; font-size: 11px; font-family: var(--mono); white-space: nowrap; cursor: default; transition: transform 0.15s; }
.todo-pill:hover { transform: scale(1.05); }
.todo-pill.approved { background: rgba(63,185,80,0.08); color: var(--green); border: 1px solid rgba(63,185,80,0.15); }
.todo-pill.rejected { background: rgba(248,81,73,0.08); color: var(--red); border: 1px solid rgba(248,81,73,0.15); }
.todo-pill.running { background: rgba(88,166,255,0.08); color: var(--accent); border: 1px solid rgba(88,166,255,0.2); }
.todo-pill.running::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); animation: blink 1.5s infinite; }
.todo-sep { color: var(--text-dim); font-size: 10px; }
.topbar-status { display: flex; align-items: center; gap: 8px; }
.status-badge { padding: 4px 14px; border-radius: 20px; font-size: 12px; font-weight: 500; }
.status-badge.running { background: rgba(63,185,80,0.08); color: var(--green); }
.status-badge.verify { background: rgba(210,153,34,0.08); color: var(--yellow); }
.status-badge.done, .status-badge.idle { background: rgba(88,166,255,0.08); color: var(--accent); }
.status-badge.dead, .status-badge.blocked { background: rgba(248,81,73,0.08); color: var(--red); }
.status-badge.salvage { background: rgba(210,153,34,0.08); color: var(--yellow); }
.run-chip { padding: 3px 12px; border-radius: 20px; font-size: 12px; background: rgba(88,166,255,0.08); color: var(--accent); white-space: nowrap; }
.status-dot { width: 8px; height: 8px; border-radius: 50%; }
.status-dot.running { background: var(--green); animation: blink 1.5s infinite; }
.status-dot.verify { background: var(--yellow); }
.status-dot.done, .status-dot.idle { background: var(--accent); }
.status-dot.dead, .status-dot.blocked { background: var(--red); animation: blink 0.5s infinite; }
.status-dot.salvage { background: var(--yellow); animation: blink 1.5s infinite; }
@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }

/* ─── Main layout ─── */
.main { display: flex; height: calc(100vh - 49px); }
.sidebar { width: 280px; min-width: 280px; background: var(--bg-card); border-right: 1px solid var(--border); padding: 16px; overflow-y: auto; }
.content { flex: 1; display: flex; flex-direction: column; overflow: hidden; background: var(--bg-deep); }

/* ─── Sidebar ─── */
.sb-section { margin-bottom: 16px; }
.sb-title { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-dim); margin-bottom: 8px; font-weight: 600; }

/* Stages */
.stage-row { display: flex; align-items: center; gap: 10px; padding: 6px 8px; border-radius: var(--radius-sm); transition: background 0.2s; }
.stage-row.current { background: var(--bg-hover); }
.stage-icon { font-size: 16px; width: 24px; text-align: center; flex-shrink: 0; }
.stage-info { flex: 1; min-width: 0; }
.stage-name { font-size: 12px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.stage-meta { font-size: 10px; color: var(--text-dim); }
.stage-meta.done { color: var(--green); }
.stage-meta.current { color: var(--accent); }
.stage-dur { font-family: var(--mono); font-size: 10px; color: var(--text-muted); flex-shrink: 0; }

/* Progress */
.progress-bar { height: 4px; background: var(--border-subtle); border-radius: 2px; overflow: hidden; margin: 8px 0 4px; }
.progress-fill { height: 100%; background: linear-gradient(90deg, var(--green), var(--accent)); border-radius: 2px; transition: width 0.5s; }
.progress-label { font-size: 10px; color: var(--text-dim); font-family: var(--mono); }

/* Elapsed */
.elapsed-card { text-align: center; padding: 8px; background: var(--bg-hover); border-radius: var(--radius-sm); }
.elapsed-value { font-size: 24px; font-family: var(--mono); font-weight: 700; color: var(--yellow); line-height: 1.2; }
.elapsed-label { font-size: 9px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-dim); }

/* Worker */
.worker-card { background: var(--bg-hover); border-radius: var(--radius-sm); padding: 10px; }
.worker-row { display: flex; justify-content: space-between; font-size: 11px; padding: 1px 0; }
.worker-label { color: var(--text-muted); }
.worker-val { font-family: var(--mono); }
.worker-line { font-size: 11px; color: var(--cyan); margin-top: 6px; padding-top: 6px; border-top: 1px solid var(--border-subtle); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-family: var(--mono); }

/* Next */
.next-card { display: flex; align-items: center; gap: 8px; padding: 8px 10px; background: var(--bg-hover); border-radius: var(--radius-sm); font-size: 11px; color: var(--text-muted); }

/* ─── Content tabs ─── */
.tabs { display: flex; gap: 2px; padding: 0 16px; border-bottom: 1px solid var(--border); background: var(--bg-card); }
.tab-btn { padding: 10px 16px; font-size: 13px; font-weight: 500; color: var(--text-muted); background: none; border: none; border-bottom: 2px solid transparent; cursor: pointer; transition: all 0.15s; }
.tab-btn:hover { color: var(--text); }
.tab-btn.active { color: var(--accent); border-bottom-color: var(--accent); }
.tab-pane { flex: 1; overflow-y: auto; padding: 20px 24px; scrollbar-width: thin; }
.tab-pane::-webkit-scrollbar { width: 6px; }
.tab-pane::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }

/* ─── Chat messages ─── */
.chat-msg { display: flex; gap: 12px; margin-bottom: 4px; animation: fadeIn 0.3s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
.chat-avatar { font-size: 20px; width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.chat-body { flex: 1; min-width: 0; }
.chat-header { display: flex; align-items: center; gap: 8px; margin-bottom: 4px; }
.chat-name { font-weight: 600; font-size: 13px; }
.chat-dur { font-size: 11px; font-family: var(--mono); color: var(--text-muted); background: var(--bg-hover); padding: 1px 6px; border-radius: 8px; }
.chat-dur.live { color: var(--accent); }
.chat-content { background: var(--bg-card); border-radius: 0 var(--radius-sm) var(--radius-sm) var(--radius-sm); padding: 12px 14px; border-left: 3px solid; }
.chat-content h1, .chat-content h2, .chat-content h3 { margin: 8px 0 4px; }
.chat-content h1 { font-size: 15px; } .chat-content h2 { font-size: 14px; } .chat-content h3 { font-size: 13px; }
.chat-content ul, .chat-content ol { padding-left: 18px; margin: 4px 0; }
.chat-content li { margin: 2px 0; font-size: 13px; }
.chat-content code { background: var(--bg-deep); padding: 2px 5px; border-radius: 3px; font-family: var(--mono); font-size: 12px; }
.chat-content pre { background: var(--bg-deep); padding: 10px; border-radius: var(--radius-sm); overflow-x: auto; margin: 6px 0; }
.chat-content pre code { background: none; padding: 0; }
.chat-content strong { color: var(--yellow); }
.chat-content p { margin: 4px 0; font-size: 13px; line-height: 1.5; }

/* Chain link between messages */
.chat-chain { display: flex; align-items: center; gap: 6px; padding: 2px 0 2px 48px; font-size: 10px; color: var(--text-dim); }
.chat-chain-arrow { font-size: 14px; }

/* ─── TODO content ─── */
.todo-content { max-width: 800px; line-height: 1.6; }
.todo-content h1 { font-size: 18px; margin-bottom: 8px; }
.todo-content h2 { font-size: 15px; margin: 14px 0 6px; color: var(--accent); }
.todo-content h3 { font-size: 13px; margin: 10px 0 4px; }
.todo-content ul, .todo-content ol { padding-left: 22px; margin: 6px 0; }
.todo-content li { margin: 3px 0; }
.todo-content code { background: var(--bg-card); padding: 2px 5px; border-radius: 3px; font-family: var(--mono); }
.todo-content pre { background: var(--bg-card); padding: 12px; border-radius: var(--radius-sm); overflow-x: auto; }
.todo-content strong { color: var(--yellow); }
.todo-diff { margin-bottom: 16px; }
.todo-diff-title { font-size: 12px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 4px; }
.todo-diff pre { background: var(--bg-card); padding: 12px; border-radius: var(--radius-sm); overflow-x: auto; font-family: var(--mono); font-size: 12px; color: var(--text); }

/* ─── Events ─── */
.event-row { display: flex; gap: 10px; padding: 5px 0; border-bottom: 1px solid var(--border-subtle); }
.event-ts { font-family: var(--mono); font-size: 10px; color: var(--text-dim); min-width: 65px; }
.event-icon { font-size: 12px; }
.event-text { flex: 1; font-size: 12px; }
.event-text.done { color: var(--green); }
.event-text.start { color: var(--accent); }
.event-text.warn { color: var(--yellow); }

/* Empty */
.empty { text-align: center; padding: 48px; color: var(--text-dim); font-size: 13px; }
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-project" id="project-name">{{ project_name }}</div>
  <div class="topbar-timeline" id="todo-timeline"></div>
  <span class="run-chip" id="run-chip" style="display:none"></span>
  <div class="topbar-status" id="status-area">
    <div class="status-dot {{ status }}" id="status-dot"></div>
    <div class="status-badge {{ status }}" id="status-badge">{{ status_text }}</div>
  </div>
</div>

<div class="main">
  <div class="sidebar">
    <div class="sb-section">
      <div class="sb-title">Pipeline</div>
      <div id="stage-list"></div>
      <div class="progress-bar"><div class="progress-fill" id="progress-fill" style="width:0%"></div></div>
      <div class="progress-label" id="progress-label"></div>
    </div>
    <div class="sb-section">
      <div class="elapsed-card">
        <div class="elapsed-value" id="elapsed-timer" data-epoch="{{ elapsed_epoch }}" data-frozen="{{ elapsed_frozen | default('false') }}">{{ elapsed }}</div>
        <div class="elapsed-label">Elapsed</div>
      </div>
    </div>
    <div class="sb-section" id="worker-section" style="display:none">
      <div class="sb-title">Worker</div>
      <div class="worker-card" id="worker-card"></div>
    </div>
    <div class="sb-section" id="next-section" style="display:none">
      <div class="sb-title">Next</div>
      <div class="next-card" id="next-preview"></div>
    </div>
  </div>

  <div class="content">
    <div class="tabs">
      <button class="tab-btn active" data-tab="chat" onclick="switchTab('chat')">💬 Agent Chat</button>
      <button class="tab-btn" data-tab="todo" onclick="switchTab('todo')">📝 Задача</button>
      <button class="tab-btn" data-tab="events" onclick="switchTab('events')">📊 События</button>
    </div>
    <div class="tab-pane" id="pane-chat"></div>
    <div class="tab-pane" id="pane-todo" style="display:none"></div>
    <div class="tab-pane" id="pane-events" style="display:none"></div>
  </div>
</div>

<script>
// ─── State ──────────────────────────────────────────────────────────
let _fetchErrors = 0;
let _renderedChatKeys = [];
let _lastTodoHtml = '';
let _notified = false;
let _notified_salvage = false;

// ─── Polling ────────────────────────────────────────────────────────
async function poll() {
  try {
    const res = await fetch('/api/state', { cache: 'no-store' });
    if (!res.ok) return;
    _fetchErrors = 0;
    const s = await res.json();
    updateAll(s);
  } catch(e) {
    _fetchErrors++;
    if (_fetchErrors === 3) {
      document.getElementById('status-badge').textContent = 'Pipeline exited';
      document.getElementById('status-badge').className = 'status-badge done';
      document.getElementById('status-dot').className = 'status-dot done';
    }
  }
}

function updateAll(s) {
  updateTopbar(s);
  updateSidebar(s);
  updateChat(s);
  updateTodo(s);
  updateEvents(s);
  updateElapsed(s);
  checkNotification(s);
}

// ─── Topbar ─────────────────────────────────────────────────────────
function updateTopbar(s) {
  document.getElementById('project-name').textContent = s.project_name || '';
  const dot = document.getElementById('status-dot');
  const badge = document.getElementById('status-badge');
  dot.className = 'status-dot ' + s.status;
  badge.className = 'status-badge ' + s.status;
  badge.textContent = s.status_text || s.status;

  // SPEC A-run: autonomous run chip
  const runChip = document.getElementById('run-chip');
  const run = s.run || null;
  if (run && run.active) {
    let label = '🏃 забег ' + (run.position || '?');
    if (run.current) label += ' · ' + run.current;
    if (run.budget_left_minutes) label += ' · ~' + run.budget_left_minutes + 'м';
    runChip.textContent = label;
    runChip.style.display = '';
  } else {
    runChip.style.display = 'none';
  }

  const tl = document.getElementById('todo-timeline');
  if (s.todo_timeline && s.todo_timeline.length > 0) {
    let html = '';
    s.todo_timeline.forEach((t, i) => {
      const icon = t.status === 'approved' ? '✅' : t.status === 'rejected' ? '❌' : '🔄';
      const sep = i < s.todo_timeline.length - 1 ? '<span class="todo-sep">─</span>' : '';
      html += '<span class="todo-pill ' + t.status + '" title="' + (t.commit_sha || '') + '">' + icon + ' ' + t.id + '</span>' + sep;
    });
    tl.innerHTML = html;
  }
}

// ─── Sidebar ────────────────────────────────────────────────────────
function updateSidebar(s) {
  const list = document.getElementById('stage-list');
  list.innerHTML = (s.stages || []).map(st => {
    const cls = 'stage-row ' + (st.status === 'current' ? 'current' : '');
    const statusIcon = st.status === 'done' ? '✓' : st.status === 'current' ? '●' : '○';
    const statusText = st.status === 'done' ? 'done' : st.status === 'current' ? 'running' : 'pending';
    return '<div class="' + cls + '">'
      + '<div class="stage-icon">' + st.icon + '</div>'
      + '<div class="stage-info"><div class="stage-name">' + st.label + '</div>'
      + '<div class="stage-meta ' + st.status + '">' + statusIcon + ' ' + statusText + '</div></div>'
      + '</div>';
  }).join('');

  const pct = s.stages_total > 0 ? (s.stages_done / s.stages_total * 100) : 0;
  document.getElementById('progress-fill').style.width = pct + '%';
  document.getElementById('progress-label').textContent = s.stages_done + '/' + s.stages_total + ' stages';

  const ws = document.getElementById('worker-section');
  if (s.worker && s.worker.active) {
    ws.style.display = 'block';
    let html = '<div class="worker-row"><span class="worker-label">PID</span><span class="worker-val">' + s.worker.worker_pid + '</span></div>'
      + '<div class="worker-row"><span class="worker-label">State</span><span class="worker-val">' + s.worker.state + '</span></div>'
      + '<div class="worker-row"><span class="worker-label">CPU</span><span class="worker-val">' + (s.worker.cpu_seconds || 0) + 's</span></div>';
    if (s.worker.last_line) html += '<div class="worker-line">▸ ' + escapeHtml(s.worker.last_line) + '</div>';
    document.getElementById('worker-card').innerHTML = html;
  } else { ws.style.display = 'none'; }

  const ns = document.getElementById('next-section');
  if (s.next_stage) {
    ns.style.display = 'block';
    document.getElementById('next-preview').innerHTML =
      '<span style="font-size:14px">' + s.next_stage.icon + '</span>'
      + '<span>Next: <strong style="color:' + s.next_stage.color + '">' + s.next_stage.label + '</strong></span>';
  } else { ns.style.display = 'none'; }
}

// ─── Chat (append-only, no flickering) ──────────────────────────────
function updateChat(s) {
  const pane = document.getElementById('pane-chat');
  const handoffs = s.handoffs || [];

  if (handoffs.length === 0) {
    if (_renderedChatKeys.length > 0) {
      pane.innerHTML = '<div class="empty">🤝 Agent handoffs появятся здесь по мере выполнения</div>';
      _renderedChatKeys = [];
    } else if (pane.innerHTML === '') {
      pane.innerHTML = '<div class="empty">🤝 Agent handoffs появятся здесь по мере выполнения</div>';
    }
    return;
  }

  // Build current keys
  const currentKeys = handoffs.map(h => h.role + '|' + (h.duration || ''));
  const keysJoined = currentKeys.join('||');

  // Only re-render if handoff set changed (new handoff or duration update)
  if (keysJoined === _renderedChatKeys.join('||')) return;

  // Full re-render only when set changes
  _renderedChatKeys = currentKeys;
  let html = '';
  handoffs.forEach((h, i) => {
    const nextH = i < handoffs.length - 1 ? handoffs[i + 1] : null;
    const durCls = h.duration ? 'chat-dur' : 'chat-dur live';
    const durText = h.duration || (i === handoffs.length - 1 && s.status === 'running' ? '...' : '');

    html += '<div class="chat-msg">'
      + '<div class="chat-avatar" style="background:' + h.color + '22">' + h.icon + '</div>'
      + '<div class="chat-body">'
      + '<div class="chat-header">'
      + '<span class="chat-name" style="color:' + h.color + '">' + h.label + '</span>'
      + (durText ? '<span class="' + durCls + '">' + durText + '</span>' : '')
      + '</div>'
      + '<div class="chat-content" style="border-left-color:' + h.color + '">' + h.content_html + '</div>'
      + '</div></div>';

    // Chain link to next agent
    if (nextH) {
      html += '<div class="chat-chain"><span class="chat-chain-arrow">↓</span> передал → ' + nextH.icon + ' ' + nextH.label + '</div>';
    }
  });
  pane.innerHTML = html;
  pane.scrollTop = pane.scrollHeight;
}

// ─── TODO content ───────────────────────────────────────────────────
function updateTodo(s) {
  const pane = document.getElementById('pane-todo');
  const html = s.todo_content_html || '';
  const diffStat = s.todo_diff_stat || '';
  const combined = diffStat + '|' + html;
  if (combined === _lastTodoHtml) return; // no change
  _lastTodoHtml = combined;

  let out = '';
  if (diffStat) {
    const esc = diffStat.replace(/&/g, '&amp;').replace(/</g, '&lt;');
    out += '<div class="todo-diff"><div class="todo-diff-title">Изменения vs baseline</div>'
         + '<pre>' + esc + '</pre></div>';
  }
  out += html
    ? '<div class="todo-content">' + html + '</div>'
    : '<div class="empty">📝 Задача появится после dispatch</div>';
  pane.innerHTML = out;
}

// ─── Events ─────────────────────────────────────────────────────────
let _lastEventsHash = '';
function updateEvents(s) {
  const pane = document.getElementById('pane-events');
  const events = s.events || [];
  const hash = events.map(e => e.ts + e.msg).join('|');
  if (hash === _lastEventsHash) return;
  _lastEventsHash = hash;

  if (events.length === 0) {
    pane.innerHTML = '<div class="empty">📊 События появятся по мере работы</div>';
    return;
  }
  pane.innerHTML = [...events].reverse().map(e => {
    const icon = e.type === 'done' ? '✅' : e.type === 'start' ? '▶' : e.type === 'warn' ? '⚠️' : '•';
    return '<div class="event-row"><span class="event-ts">' + e.ts + '</span><span class="event-icon">' + icon + '</span><span class="event-text ' + e.type + '">' + escapeHtml(e.msg) + '</span></div>';
  }).join('');
}

// ─── Elapsed ────────────────────────────────────────────────────────
function updateElapsed(s) {
  const el = document.getElementById('elapsed-timer');
  el.dataset.epoch = s.elapsed_epoch || 0;
  el.dataset.frozen = s.elapsed_frozen || false;
  if (s.elapsed_str) el.textContent = s.elapsed_str;
  tickElapsed();
}
function tickElapsed() {
  const el = document.getElementById('elapsed-timer');
  if (!el || el.dataset.frozen === 'true') return;
  const epoch = parseInt(el.dataset.epoch || '0');
  if (!epoch) return;
  const elapsed = Math.floor(Date.now() / 1000) - epoch;
  if (elapsed < 0) return;
  const m = Math.floor(elapsed / 60), sec = elapsed % 60;
  el.textContent = m > 0 ? m + 'm ' + sec + 's' : sec + 's';
}
tickElapsed();
setInterval(tickElapsed, 1000);

// ─── Tabs ───────────────────────────────────────────────────────────
function switchTab(name) {
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === name));
  document.querySelectorAll('.tab-pane').forEach(p => p.style.display = 'none');
  const pane = document.getElementById('pane-' + name);
  if (pane) pane.style.display = 'block';
}

// ─── Notifications ──────────────────────────────────────────────────
function checkNotification(s) {
  if (s.status === 'verify' && !_notified) {
    _notified = true;
    if ('Notification' in window && Notification.permission === 'granted') {
      new Notification('awf: Pipeline at verify', { body: (s.todo_id || '') + ' — ready for review' });
    }
  }
  if (s.status === 'salvage' && !_notified_salvage) {
    _notified_salvage = true;
    if ('Notification' in window && Notification.permission === 'granted') {
      new Notification('awf: Salvage needed', { body: (s.salvage_stage || 'worker') + ' did not signal — decision needed' });
    }
  }
  if (s.status !== 'verify') _notified = false;
  if (s.status !== 'salvage') _notified_salvage = false;
}
if ('Notification' in window && Notification.permission === 'default') {
  Notification.requestPermission();
}

// ─── Helpers ────────────────────────────────────────────────────────
function escapeHtml(s) {
  const d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML;
}

// ─── Init + Poll ────────────────────────────────────────────────────
const INITIAL_STATE = {{ initial_state_json | safe }};
updateAll(INITIAL_STATE);
setInterval(poll, 3000);
</script>
