{# Pipeline dashboard — generated by awf.api.dashboard.generate_dashboard().

  Rendered to .agentic/dashboards/current.html after each pipeline state
  change. Auto-refreshes via <meta http-equiv="refresh" content="5">.

  NOT a form template (no open_form lifecycle). Standalone HTML opened
  directly in browser via open_path.
#}
<!DOCTYPE html>
<html lang="{{ lang | default('ru') }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="refresh" content="5">
  <title>Pipeline · {{ project_name }} · {{ todo_id }}</title>
  <style>
    :root {
      --bg: #1e1e1e;
      --bg-card: #252526;
      --bg-card-hover: #2d2d2d;
      --bg-input: #3c3c3c;
      --text: #d4d4d4;
      --text-muted: #858585;
      --text-dim: #5a5a5a;
      --accent: #569cd6;
      --accent-green: #4ec9b0;
      --accent-yellow: #dcdcaa;
      --accent-purple: #c586c0;
      --accent-cyan: #4fc1ff;
      --danger: #f14c4c;
      --border: #464647;
      --radius: 6px;
      --mono: 'SF Mono', 'Cascadia Code', 'JetBrains Mono', monospace;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg); color: var(--text);
      font-family: system-ui, -apple-system, sans-serif;
      font-size: 14px; min-height: 100vh; line-height: 1.5;
    }

    .header {
      background: var(--bg-card); border-bottom: 1px solid var(--border);
      padding: 20px 32px; display: flex; align-items: center; gap: 24px;
    }
    .header-icon {
      width: 44px; height: 44px; border-radius: var(--radius);
      background: linear-gradient(135deg, var(--accent), var(--accent-purple));
      display: flex; align-items: center; justify-content: center;
      font-size: 22px;
      animation: breathe 3s ease-in-out infinite;
    }
    @keyframes breathe {
      0%,100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(86,156,214,0.3); }
      50% { transform: scale(1.05); box-shadow: 0 0 16px 3px rgba(86,156,214,0.12); }
    }
    .header-info { flex: 1; }
    .header-project { font-size: 19px; font-weight: 600; }
    .header-todo { font-family: var(--mono); font-size: 13px; color: var(--text-muted); margin-top: 2px; }
    .header-stats { display: flex; gap: 24px; }
    .stat { text-align: center; }
    .stat-value { font-size: 17px; font-weight: 600; font-family: var(--mono); }
    .stat-label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px; }
    .stat-value.running { color: var(--accent-green); }
    .stat-value.elapsed { color: var(--accent-yellow); }

    .status-badge {
      display: inline-flex; align-items: center; gap: 8px;
      padding: 5px 13px; border-radius: 14px; font-size: 13px; font-weight: 500;
    }
    .status-badge.running { background: rgba(78,201,176,0.1); color: var(--accent-green); border: 1px solid rgba(78,201,176,0.2); }
    .status-badge.checkpoint { background: rgba(220,220,170,0.1); color: var(--accent-yellow); border: 1px solid rgba(220,220,170,0.2); }
    .status-badge.done { background: rgba(86,156,214,0.1); color: var(--accent); border: 1px solid rgba(86,156,214,0.2); }
    .status-badge.blocked { background: rgba(241,76,76,0.1); color: var(--danger); border: 1px solid rgba(241,76,76,0.2); }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; }
    .status-dot.running { background: var(--accent-green); animation: blink 1.5s infinite; }
    .status-dot.checkpoint { background: var(--accent-yellow); animation: blink 0.8s infinite; }
    .status-dot.done { background: var(--accent); }
    .status-dot.blocked { background: var(--danger); animation: blink 0.5s infinite; }
    @keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }

    {% if checkpoint_pending %}
    .checkpoint-banner {
      background: linear-gradient(135deg, rgba(220,220,170,0.12), rgba(197,134,192,0.08));
      border: 1px solid rgba(220,220,170,0.25);
      border-radius: var(--radius); padding: 16px 24px; margin: 20px 32px;
      display: flex; align-items: center; gap: 16px;
      animation: glow-pulse 2s ease-in-out infinite;
    }
    @keyframes glow-pulse {
      0%,100% { box-shadow: 0 0 0 0 rgba(220,220,170,0); }
      50% { box-shadow: 0 0 20px 2px rgba(220,220,170,0.08); }
    }
    .checkpoint-icon { font-size: 22px; }
    .checkpoint-text { flex: 1; }
    .checkpoint-title { font-weight: 600; color: var(--accent-yellow); }
    .checkpoint-desc { font-size: 13px; color: var(--text-muted); margin-top: 2px; }
    .checkpoint-btn {
      background: var(--accent-yellow); color: var(--bg); border: none;
      padding: 7px 18px; border-radius: 4px; font-size: 13px; font-weight: 600;
      cursor: pointer; text-decoration: none; transition: transform 0.15s;
    }
    .checkpoint-btn:hover { transform: scale(1.05); }
    {% endif %}

    .pipeline-flow {
      padding: 28px 32px; display: flex; align-items: center; gap: 0;
      overflow-x: auto;
    }
    .stage-node { display: flex; flex-direction: column; align-items: center; gap: 6px; min-width: 90px; position: relative; z-index: 1; }
    .stage-circle {
      width: 34px; height: 34px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-size: 13px; font-weight: 600; transition: all 0.3s;
    }
    .stage-circle.done { background: var(--accent-green); color: var(--bg); box-shadow: 0 0 10px rgba(78,201,176,0.25); }
    .stage-circle.current { background: var(--accent); color: var(--bg); animation: pulse-ring 2s ease-out infinite; }
    @keyframes pulse-ring {
      0% { box-shadow: 0 0 0 0 rgba(86,156,214,0.5); }
      100% { box-shadow: 0 0 0 14px rgba(86,156,214,0); }
    }
    .stage-circle.pending { background: var(--bg-input); color: var(--text-dim); border: 2px solid var(--border); }
    .stage-label { font-size: 12px; text-align: center; white-space: nowrap; }
    .stage-label.done { color: var(--accent-green); }
    .stage-label.current { color: var(--accent); font-weight: 600; }
    .stage-label.pending { color: var(--text-dim); }
    .stage-role { font-size: 10px; color: var(--text-dim); font-family: var(--mono); }
    .stage-connector { flex: 1; height: 3px; min-width: 24px; border-radius: 2px; margin: -26px 4px 0; z-index: 0; }
    .stage-connector.done { background: var(--accent-green); }
    .stage-connector.pending { background: var(--border); }

    .cards-section { padding: 0 32px 32px; display: flex; flex-direction: column; gap: 10px; }
    .card { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; transition: border-color 0.2s; }
    .card:hover { border-color: var(--accent); }
    .card-header {
      padding: 13px 20px; display: flex; align-items: center; gap: 12px;
      cursor: pointer; user-select: none; transition: background 0.15s;
    }
    .card-header:hover { background: var(--bg-card-hover); }
    .card-icon { font-size: 15px; width: 20px; text-align: center; }
    .card-title { flex: 1; font-size: 14px; font-weight: 500; }
    .card-count { background: var(--bg-input); color: var(--text-muted); padding: 2px 10px; border-radius: 10px; font-size: 12px; font-family: var(--mono); }
    .card-chevron { color: var(--text-dim); transition: transform 0.3s; font-size: 11px; }
    .card.expanded .card-chevron { transform: rotate(90deg); }
    .card-body { max-height: 0; overflow: hidden; transition: max-height 0.3s ease; }
    .card.expanded .card-body { max-height: 2000px; }

    .handoff-item { padding: 12px 20px; border-top: 1px solid var(--border); display: flex; gap: 12px; align-items: flex-start; }
    .handoff-role { font-family: var(--mono); font-size: 12px; color: var(--accent-purple); min-width: 130px; padding-top: 2px; }
    .handoff-content { flex: 1; }
    .handoff-file { font-family: var(--mono); font-size: 13px; color: var(--accent-cyan); margin-bottom: 4px; }
    .handoff-preview { font-size: 12px; color: var(--text-muted); white-space: pre-wrap; max-height: 60px; overflow: hidden; position: relative; }
    .handoff-preview::after { content: ''; position: absolute; bottom: 0; left: 0; right: 0; height: 20px; background: linear-gradient(transparent, var(--bg-card)); }

    .events-stream { padding: 12px 20px; border-top: 1px solid var(--border); font-family: var(--mono); font-size: 13px; max-height: 400px; overflow-y: auto; }
    .event-line { display: flex; gap: 12px; padding: 3px 0; animation: slideIn 0.3s ease; }
    @keyframes slideIn { from { opacity: 0; transform: translateX(-8px); } to { opacity: 1; transform: translateX(0); } }
    .event-ts { color: var(--text-dim); min-width: 70px; }
    .event-msg { flex: 1; }
    .event-msg.done { color: var(--accent-green); }
    .event-msg.start { color: var(--accent); }
    .event-msg.info { color: var(--text-muted); }
    .event-msg.warn { color: var(--accent-yellow); }
    .event-msg.error { color: var(--danger); }

    .task-item { padding: 10px 20px; border-top: 1px solid var(--border); display: flex; gap: 10px; align-items: center; }
    .task-check { width: 18px; height: 18px; border-radius: 4px; border: 2px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 11px; }
    .task-check.done { background: var(--accent-green); border-color: var(--accent-green); color: var(--bg); }
    .task-check.active { border-color: var(--accent); animation: spin-border 1s linear infinite; }
    @keyframes spin-border { 0% { border-top-color: var(--accent); } 25% { border-right-color: var(--accent); } 50% { border-bottom-color: var(--accent); } 75% { border-left-color: var(--accent); } }
    .task-check.pending { opacity: 0.3; }
    .task-text { flex: 1; font-size: 13px; }
    .task-text.done { color: var(--text-muted); text-decoration: line-through; }
    .task-text.active { color: var(--text); }
    .task-text.pending { color: var(--text-dim); }

    {% if worker_activity %}
    .worker-activity {
      padding: 14px 20px;
      border-top: 1px solid var(--border);
      display: flex; gap: 20px; align-items: center;
      font-family: var(--mono); font-size: 13px;
    }
    .wa-indicator {
      width: 10px; height: 10px; border-radius: 50%;
      animation: blink {% if worker_activity.state == 'running' %}0.8s{% else %}2s{% endif %} infinite;
    }
    .wa-indicator.active { background: var(--accent-green); }
    .wa-indicator.sleeping { background: var(--accent-yellow); }
    .wa-indicator.zombie { background: var(--danger); }
    .wa-indicator.inactive { background: var(--text-dim); animation: none; }
    .wa-stat { color: var(--text-muted); }
    .wa-stat strong { color: var(--text); font-family: var(--mono); }
    {% endif %}

    .footer {
      padding: 20px 32px; border-top: 1px solid var(--border);
      text-align: center; font-size: 13px; color: var(--text-muted);
    }
    .footer.done-notice { background: rgba(86,156,214,0.05); color: var(--accent); font-weight: 500; }
    ::-webkit-scrollbar { width: 8px; }
    ::-webkit-scrollbar-track { background: var(--bg); }
    ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 4px; }
  </style>
</head>
<body>

<div class="header">
  <div class="header-icon">⚡</div>
  <div class="header-info">
    <div class="header-project">{{ project_name }}</div>
    <div class="header-todo">{{ todo_id }}{% if todo_summary %} · {{ todo_summary }}{% endif %}</div>
  </div>
  <div class="header-stats">
    <div class="stat">
      <div class="stat-value {{ status_class }}">{{ status_icon }}</div>
      <div class="stat-label">{{ status_label }}</div>
    </div>
    {% if elapsed %}
    <div class="stat">
      <div class="stat-value elapsed">{{ elapsed }}</div>
      <div class="stat-label">Elapsed</div>
    </div>
    {% endif %}
    <div class="stat">
      <div class="stat-value" style="color: var(--accent-green)">{{ stages_done }}/{{ stages_total }}</div>
      <div class="stat-label">Stages</div>
    </div>
    {% if completed_todos %}
    <div class="stat">
      <div class="stat-value" style="color: var(--accent-green)">{{ completed_todos | length }}</div>
      <div class="stat-label">Done TODOs</div>
    </div>
    {% endif %}
  </div>
  <div class="status-badge {{ status_class }}">
    <div class="status-dot {{ status_class }}"></div>
    {{ status_text }}
  </div>
</div>

{% if checkpoint_pending %}
<div class="checkpoint-banner">
  <div class="checkpoint-icon">⏸</div>
  <div class="checkpoint-text">
    <div class="checkpoint-title">BD-36 Plan checkpoint pending</div>
    <div class="checkpoint-desc">Review {{ todo_id }} before agents start. Form open in browser.</div>
  </div>
  {% if checkpoint_form_url %}
  <a href="{{ checkpoint_form_url }}" class="checkpoint-btn">Open approve form →</a>
  {% endif %}
</div>
{% endif %}

<div class="pipeline-flow">
  {% for stage in stages %}
  <div class="stage-node">
    <div class="stage-circle {{ stage.status }}">
      {% if stage.status == 'done' %}✓{% elif stage.status == 'current' %}●{% else %}·{% endif %}
    </div>
    <div class="stage-label {{ stage.status }}">{{ stage.name }}</div>
    {% if stage.model %}<div class="stage-role">{{ stage.model }}</div>{% endif %}
  </div>
  {% if not loop.last %}
  <div class="stage-connector {{ stage.status if stage.status == 'done' else 'pending' }}"></div>
  {% endif %}
  {% endfor %}
</div>

{% if worker_activity and worker_activity.active %}
<div style="padding: 0 32px;">
  <div class="worker-activity" style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);">
    <div class="wa-indicator {% if 'running' in worker_activity.state %}active{% elif 'sleeping' in worker_activity.state %}sleeping{% elif 'zombie' in worker_activity.state %}zombie{% else %}inactive{% endif %}"></div>
    <span style="color: var(--text); font-weight: 500;">Worker</span>
    <span class="wa-stat">PID <strong>{{ worker_activity.worker_pid }}</strong></span>
    <span class="wa-stat">{{ worker_activity.state }}</span>
    <span class="wa-stat">CPU <strong>{{ worker_activity.cpu_seconds }}s</strong></span>
    <span class="wa-stat">↓ <strong>{{ worker_activity.read_mb }}MB</strong></span>
    <span class="wa-stat">↑ <strong>{{ worker_activity.write_kb }}KB</strong></span>
  </div>
</div>
{% elif worker_activity and not worker_activity.active %}
<div style="padding: 0 32px;">
  <div class="worker-activity" style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);">
    <div class="wa-indicator inactive"></div>
    <span style="color: var(--text-muted);">{{ worker_activity.reason | default('Worker not active') }}</span>
  </div>
</div>
{% endif %}

<div class="cards-section">

  {% if events %}
  <div class="card {% if events_expanded is not defined %}expanded{% elif events_expanded %}expanded{% endif %}" onclick="this.classList.toggle('expanded')">
    <div class="card-header">
      <div class="card-icon">📡</div>
      <div class="card-title">Events stream</div>
      <div class="card-count">{{ events | length }}</div>
      <div class="card-chevron">▶</div>
    </div>
    <div class="card-body">
      <div class="events-stream">
        {% for event in events %}
        <div class="event-line">
          <span class="event-ts">{{ event.ts }}</span>
          <span class="event-msg {{ event.type }}">{{ event.msg }}</span>
        </div>
        {% endfor %}
      </div>
    </div>
  </div>
  {% endif %}

  {% if handoffs %}
  <div class="card" onclick="this.classList.toggle('expanded')">
    <div class="card-header">
      <div class="card-icon">📦</div>
      <div class="card-title">Handoffs</div>
      <div class="card-count">{{ handoffs | length }}</div>
      <div class="card-chevron">▶</div>
    </div>
    <div class="card-body">
      {% for handoff in handoffs %}
      <div class="handoff-item">
        <div class="handoff-role">{{ handoff.role }}</div>
        <div class="handoff-content">
          <div class="handoff-file">{{ handoff.file }}</div>
          {% if handoff.preview %}
          <div class="handoff-preview">{{ handoff.preview }}</div>
          {% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if tasks %}
  <div class="card" onclick="this.classList.toggle('expanded')">
    <div class="card-header">
      <div class="card-icon">📋</div>
      <div class="card-title">Task progress</div>
      <div class="card-count">{{ tasks_done }}/{{ tasks | length }}</div>
      <div class="card-chevron">▶</div>
    </div>
    <div class="card-body">
      {% for task in tasks %}
      <div class="task-item">
        <div class="task-check {{ task.status }}">
          {% if task.status == 'done' %}✓{% endif %}
        </div>
        <div class="task-text {{ task.status }}">{{ task.text }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  {% if completed_todos %}
  <div class="card expanded">
    <div class="card-header">
      <div class="card-icon">✅</div>
      <div class="card-title">Completed TODOs</div>
      <div class="card-count">{{ completed_todos | length }}</div>
      <div class="card-chevron">▶</div>
    </div>
    <div class="card-body">
      {% for todo in completed_todos %}
      <div class="task-item">
        <div class="task-check done">✓</div>
        <div class="task-text done">{{ todo }}</div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}

</div>

{% if status == 'done' %}
<div class="footer done-notice">
  ✅ Pipeline complete — return to chat for supervisor verify
</div>
{% else %}
<div class="footer">
  Auto-refresh every 5s · Powered by awf pipeline
</div>
{% endif %}

</body>
</html>
