{# Dashboard v2 — two-panel layout, live polling via HTTP server #}
<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>awf · {{ project_name }} · {{ todo_id }}</title>
<style>
:root {
  --bg: #0d1117; --bg-card: #161b22; --bg-hover: #1c2128;
  --text: #e6edf3; --text-muted: #8b949e; --text-dim: #484f58;
  --accent: #58a6ff; --green: #3fb950; --yellow: #d29922; --red: #f85149;
  --purple: #bc8cff; --orange: #db6d28; --cyan: #39c5cf;
  --border: #30363d; --radius: 10px; --mono: 'SF Mono','JetBrains Mono',monospace;
  --shadow: 0 2px 8px rgba(0,0,0,0.3);
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body { background: var(--bg); color: var(--text); font-family: system-ui,-apple-system,sans-serif; font-size: 14px; height: 100vh; overflow: hidden; }

/* ─── Top bar ─── */
.topbar { display: flex; align-items: center; gap: 20px; padding: 12px 24px; background: var(--bg-card); border-bottom: 1px solid var(--border); }
.topbar-project { font-size: 16px; font-weight: 600; white-space: nowrap; }
.topbar-timeline { display: flex; align-items: center; gap: 6px; flex: 1; overflow-x: auto; }
.todo-pill { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 12px; font-size: 11px; font-family: var(--mono); white-space: nowrap; cursor: pointer; transition: all 0.2s; }
.todo-pill.approved { background: rgba(63,185,80,0.1); color: var(--green); border: 1px solid rgba(63,185,80,0.2); }
.todo-pill.rejected { background: rgba(248,81,73,0.1); color: var(--red); border: 1px solid rgba(248,81,73,0.2); }
.todo-pill.running { background: rgba(88,166,255,0.1); color: var(--accent); border: 1px solid rgba(88,166,255,0.3); animation: pulse 2s infinite; }
@keyframes pulse { 0%,100% { opacity: 1; } 50% { opacity: 0.6; } }
.todo-sep { color: var(--text-dim); font-size: 10px; }
.topbar-status { display: flex; align-items: center; gap: 8px; }
.status-badge { padding: 4px 12px; border-radius: 12px; font-size: 12px; font-weight: 500; }
.status-badge.running { background: rgba(63,185,80,0.1); color: var(--green); }
.status-badge.verify { background: rgba(210,153,34,0.1); color: var(--yellow); }
.status-badge.done, .status-badge.idle { background: rgba(88,166,255,0.1); color: var(--accent); }
.status-badge.dead, .status-badge.blocked { background: rgba(248,81,73,0.1); color: var(--red); }
.status-dot { width: 8px; height: 8px; border-radius: 50%; }
.status-dot.running { background: var(--green); animation: blink 1.5s infinite; }
.status-dot.verify { background: var(--yellow); }
.status-dot.done, .status-dot.idle { background: var(--accent); }
.status-dot.dead, .status-dot.blocked { background: var(--red); animation: blink 0.5s infinite; }
@keyframes blink { 0%,100% { opacity: 1; } 50% { opacity: 0.3; } }

/* ─── Main layout ─── */
.main { display: flex; height: calc(100vh - 53px); }
.sidebar { width: 300px; min-width: 300px; background: var(--bg-card); border-right: 1px solid var(--border); padding: 20px; overflow-y: auto; }
.content { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

/* ─── Sidebar: pipeline stages ─── */
.sidebar-section { margin-bottom: 20px; }
.sidebar-title { font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-muted); margin-bottom: 10px; }
.stage-list { display: flex; flex-direction: column; gap: 4px; }
.stage-row { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: var(--radius); transition: background 0.2s; }
.stage-row.current { background: var(--bg-hover); }
.stage-icon { font-size: 18px; width: 28px; text-align: center; }
.stage-info { flex: 1; }
.stage-name { font-size: 13px; font-weight: 500; }
.stage-status { font-size: 11px; color: var(--text-muted); }
.stage-status.done { color: var(--green); }
.stage-status.current { color: var(--accent); }
.stage-duration { font-family: var(--mono); font-size: 11px; color: var(--text-muted); }

/* Progress bar */
.progress-wrap { margin: 12px 0; }
.progress-bar { height: 6px; background: var(--bg-hover); border-radius: 3px; overflow: hidden; }
.progress-fill { height: 100%; background: linear-gradient(90deg, var(--green), var(--accent)); border-radius: 3px; transition: width 0.5s ease; }
.progress-label { font-size: 11px; color: var(--text-muted); margin-top: 4px; font-family: var(--mono); }

/* Worker card */
.worker-card { background: var(--bg-hover); border-radius: var(--radius); padding: 12px; }
.worker-row { display: flex; justify-content: space-between; font-size: 12px; padding: 2px 0; }
.worker-label { color: var(--text-muted); }
.worker-value { font-family: var(--mono); }
.worker-line { font-size: 12px; color: var(--cyan); margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--border); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.worker-line::before { content: '▸ '; color: var(--text-dim); }

/* Elapsed timer */
.elapsed-card { text-align: center; padding: 12px; }
.elapsed-value { font-size: 28px; font-family: var(--mono); font-weight: 600; color: var(--yellow); }
.elapsed-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1px; color: var(--text-muted); margin-top: 2px; }

/* ─── Content area: tabs ─── */
.tabs { display: flex; gap: 4px; padding: 0 20px; border-bottom: 1px solid var(--border); background: var(--bg-card); }
.tab-btn { padding: 10px 16px; font-size: 13px; font-weight: 500; color: var(--text-muted); background: none; border: none; border-bottom: 2px solid transparent; cursor: pointer; transition: all 0.2s; }
.tab-btn:hover { color: var(--text); }
.tab-btn.active { color: var(--accent); border-bottom-color: var(--accent); }
.tab-pane { flex: 1; overflow-y: auto; padding: 20px; }

/* ─── Chat-style handoffs ─── */
.chat-msg { display: flex; gap: 12px; margin-bottom: 16px; animation: fadeIn 0.4s ease; }
@keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }
.chat-avatar { font-size: 24px; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.chat-body { flex: 1; min-width: 0; }
.chat-header { display: flex; align-items: center; gap: 8px; margin-bottom: 6px; }
.chat-name { font-weight: 600; font-size: 13px; }
.chat-time { font-size: 11px; color: var(--text-dim); font-family: var(--mono); }
.chat-content { background: var(--bg-card); border-radius: 0 var(--radius) var(--radius) var(--radius); padding: 14px 16px; border-left: 3px solid var(--border); }
.chat-content h1, .chat-content h2, .chat-content h3 { margin: 10px 0 6px; }
.chat-content h1 { font-size: 16px; } .chat-content h2 { font-size: 15px; } .chat-content h3 { font-size: 14px; }
.chat-content ul, .chat-content ol { padding-left: 20px; margin: 4px 0; }
.chat-content li { margin: 2px 0; }
.chat-content code { background: var(--bg-hover); padding: 2px 6px; border-radius: 3px; font-family: var(--mono); font-size: 12px; }
.chat-content pre { background: var(--bg-hover); padding: 10px; border-radius: 6px; overflow-x: auto; margin: 8px 0; }
.chat-content pre code { background: none; padding: 0; }
.chat-content strong { color: var(--yellow); }

/* ─── TODO content ─── */
.todo-content { max-width: 800px; }
.todo-content h1 { font-size: 20px; margin-bottom: 12px; }
.todo-content h2 { font-size: 16px; margin: 16px 0 8px; color: var(--accent); }
.todo-content h3 { font-size: 14px; margin: 12px 0 6px; }
.todo-content ul, .todo-content ol { padding-left: 24px; margin: 8px 0; }
.todo-content li { margin: 4px 0; line-height: 1.6; }
.todo-content code { background: var(--bg-hover); padding: 2px 6px; border-radius: 3px; font-family: var(--mono); }
.todo-content pre { background: var(--bg-hover); padding: 12px; border-radius: var(--radius); overflow-x: auto; }
.todo-content strong { color: var(--yellow); }

/* ─── Events ─── */
.event-row { display: flex; gap: 10px; padding: 6px 0; border-bottom: 1px solid rgba(48,54,61,0.5); }
.event-ts { font-family: var(--mono); font-size: 11px; color: var(--text-dim); min-width: 70px; }
.event-icon { font-size: 14px; }
.event-text { flex: 1; font-size: 13px; }
.event-text.done { color: var(--green); }
.event-text.start { color: var(--accent); }
.event-text.warn { color: var(--yellow); }

/* ─── Next stage preview ─── */
.next-preview { display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: var(--bg-hover); border-radius: var(--radius); font-size: 12px; color: var(--text-muted); }

/* ─── Empty state ─── */
.empty { text-align: center; padding: 40px; color: var(--text-dim); font-size: 14px; }
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-project" id="project-name">{{ project_name }}</div>
  <div class="topbar-timeline" id="todo-timeline"></div>
  <div class="topbar-status" id="status-area">
    <div class="status-dot {{ status }}" id="status-dot"></div>
    <div class="status-badge {{ status }}" id="status-badge">{{ status_text }}</div>
  </div>
</div>

<div class="main">
  <!-- Left sidebar: pipeline -->
  <div class="sidebar">
    <div class="sidebar-section">
      <div class="sidebar-title">Pipeline</div>
      <div class="stage-list" id="stage-list"></div>
    </div>
    <div class="progress-wrap">
      <div class="progress-bar"><div class="progress-fill" id="progress-fill" style="width:0%"></div></div>
      <div class="progress-label" id="progress-label">0/0</div>
    </div>
    <div class="sidebar-section">
      <div class="elapsed-card">
        <div class="elapsed-value" id="elapsed-timer" data-epoch="{{ elapsed_epoch }}" data-frozen="{{ elapsed_frozen | default('false') }}">{{ elapsed }}</div>
        <div class="elapsed-label">Elapsed</div>
      </div>
    </div>
    <div class="sidebar-section" id="worker-section" style="display:none">
      <div class="sidebar-title">Worker</div>
      <div class="worker-card" id="worker-card"></div>
    </div>
    <div class="sidebar-section" id="next-section" style="display:none">
      <div class="sidebar-title">Next</div>
      <div class="next-preview" id="next-preview"></div>
    </div>
  </div>

  <!-- Right content: tabs -->
  <div class="content">
    <div class="tabs">
      <button class="tab-btn active" data-tab="chat" onclick="switchTab('chat')">💬 Agent Chat</button>
      <button class="tab-btn" data-tab="todo" onclick="switchTab('todo')">📝 Задача</button>
      <button class="tab-btn" data-tab="events" onclick="switchTab('events')">📊 События</button>
    </div>
    <div class="tab-pane" id="pane-chat"></div>
    <div class="tab-pane" id="pane-todo" style="display:none"></div>
    <div class="tab-pane" id="pane-events" style="display:none"></div>
  </div>
</div>

<script>
// ─── State polling ──────────────────────────────────────────────────
let _prevStatus = '{{ status }}';
let _fetchErrors = 0;

async function poll() {
  try {
    const res = await fetch('/api/state', { cache: 'no-store' });
    if (!res.ok) return;
    _fetchErrors = 0;
    const s = await res.json();
    updateAll(s);
  } catch(e) {
    _fetchErrors++;
    if (_fetchErrors === 3) {
      // Server likely dead (pipeline exited)
      const badge = document.getElementById('status-badge');
      badge.textContent = 'Pipeline exited';
      badge.className = 'status-badge done';
      document.getElementById('status-dot').className = 'status-dot done';
    }
  }
}

function updateAll(s) {
  updateTopbar(s);
  updateSidebar(s);
  updateChat(s);
  updateTodo(s);
  updateEvents(s);
  updateElapsed(s);
  checkNotification(s);
}

// ─── Topbar ─────────────────────────────────────────────────────────
function updateTopbar(s) {
  document.getElementById('project-name').textContent = s.project_name;
  // Status
  const dot = document.getElementById('status-dot');
  const badge = document.getElementById('status-badge');
  dot.className = 'status-dot ' + s.status;
  badge.className = 'status-badge ' + s.status;
  badge.textContent = s.status_text || s.status;
  // TODO timeline
  const tl = document.getElementById('todo-timeline');
  if (s.todo_timeline && s.todo_timeline.length > 0) {
    tl.innerHTML = s.todo_timeline.map((t, i) => {
      const icon = t.status === 'approved' ? '✅' : t.status === 'rejected' ? '❌' : '🔄';
      const sep = i < s.todo_timeline.length - 1 ? '<span class="todo-sep">─</span>' : '';
      return '<span class="todo-pill ' + t.status + '" title="' + (t.commit_sha || '') + '">' + icon + ' ' + t.id + '</span>' + sep;
    }).join('');
  } else {
    tl.innerHTML = '';
  }
}

// ─── Sidebar ────────────────────────────────────────────────────────
function updateSidebar(s) {
  // Stages
  const list = document.getElementById('stage-list');
  list.innerHTML = (s.stages || []).map(st => {
    const cls = 'stage-row ' + (st.status === 'current' ? 'current' : '');
    const statusIcon = st.status === 'done' ? '✓' : st.status === 'current' ? '●' : '·';
    const statusCls = 'stage-status ' + st.status;
    const dur = st.duration ? '<div class="stage-duration">' + st.duration + '</div>' : '';
    return '<div class="' + cls + '">'
      + '<div class="stage-icon">' + st.icon + '</div>'
      + '<div class="stage-info"><div class="stage-name">' + st.label + '</div>'
      + '<div class="' + statusCls + '">' + statusIcon + ' ' + st.status + '</div></div>'
      + dur + '</div>';
  }).join('');

  // Progress
  const pct = s.stages_total > 0 ? (s.stages_done / s.stages_total * 100) : 0;
  document.getElementById('progress-fill').style.width = pct + '%';
  document.getElementById('progress-label').textContent = s.stages_done + '/' + s.stages_total + ' stages';

  // Worker
  const ws = document.getElementById('worker-section');
  if (s.worker && s.worker.active) {
    ws.style.display = 'block';
    let html = '<div class="worker-row"><span class="worker-label">PID</span><span class="worker-value">' + s.worker.worker_pid + '</span></div>'
      + '<div class="worker-row"><span class="worker-label">State</span><span class="worker-value">' + s.worker.state + '</span></div>'
      + '<div class="worker-row"><span class="worker-label">CPU</span><span class="worker-value">' + s.worker.cpu_seconds + 's</span></div>';
    if (s.worker.last_line) {
      html += '<div class="worker-line">' + escapeHtml(s.worker.last_line) + '</div>';
    }
    document.getElementById('worker-card').innerHTML = html;
  } else {
    ws.style.display = 'none';
  }

  // Next stage
  const ns = document.getElementById('next-section');
  if (s.next_stage) {
    ns.style.display = 'block';
    document.getElementById('next-preview').innerHTML =
      '<span style="font-size:16px">' + s.next_stage.icon + '</span>'
      + '<span>Next: <strong style="color:' + s.next_stage.color + '">' + s.next_stage.label + '</strong></span>';
  } else {
    ns.style.display = 'none';
  }
}

// ─── Chat handoffs ──────────────────────────────────────────────────
function updateChat(s) {
  const pane = document.getElementById('pane-chat');
  if (!s.handoffs || s.handoffs.length === 0) {
    pane.innerHTML = '<div class="empty">🤝 Agent handoffs появятся здесь по мере выполнения</div>';
    return;
  }
  pane.innerHTML = s.handoffs.map(h => {
    return '<div class="chat-msg">'
      + '<div class="chat-avatar" style="background:' + h.color + '22">' + h.icon + '</div>'
      + '<div class="chat-body">'
      + '<div class="chat-header">'
      + '<span class="chat-name" style="color:' + h.color + '">' + h.label + '</span>'
      + (h.duration ? '<span class="chat-time">' + h.duration + '</span>' : '')
      + '</div>'
      + '<div class="chat-content" style="border-left-color:' + h.color + '">' + h.content_html + '</div>'
      + '</div></div>';
  }).join('');
  // Auto-scroll to bottom
  pane.scrollTop = pane.scrollHeight;
}

// ─── TODO content ───────────────────────────────────────────────────
function updateTodo(s) {
  const pane = document.getElementById('pane-todo');
  if (!s.todo_content_html) {
    pane.innerHTML = '<div class="empty">📝 Задача появится здесь после dispatch</div>';
  } else {
    pane.innerHTML = '<div class="todo-content">' + s.todo_content_html + '</div>';
  }
}

// ─── Events ─────────────────────────────────────────────────────────
function updateEvents(s) {
  const pane = document.getElementById('pane-events');
  if (!s.events || s.events.length === 0) {
    pane.innerHTML = '<div class="empty">📊 События появятся по мере работы pipeline</div>';
    return;
  }
  pane.innerHTML = [...s.events].reverse().map(e => {
    return '<div class="event-row">'
      + '<span class="event-ts">' + e.ts + '</span>'
      + '<span class="event-icon">' + (e.type === 'done' ? '✅' : e.type === 'start' ? '▶' : e.type === 'warn' ? '⚠️' : '•') + '</span>'
      + '<span class="event-text ' + e.type + '">' + escapeHtml(e.msg) + '</span>'
      + '</div>';
  }).join('');
}

// ─── Elapsed timer ──────────────────────────────────────────────────
function updateElapsed(s) {
  const el = document.getElementById('elapsed-timer');
  el.dataset.epoch = s.elapsed_epoch || 0;
  el.dataset.frozen = s.elapsed_frozen || false;
  if (s.elapsed_str) el.textContent = s.elapsed_str;
  tickElapsed();
}

function tickElapsed() {
  const el = document.getElementById('elapsed-timer');
  if (!el || el.dataset.frozen === 'true') return;
  const epoch = parseInt(el.dataset.epoch || '0');
  if (!epoch) return;
  const elapsed = Math.floor(Date.now() / 1000) - epoch;
  if (elapsed < 0) return;
  const m = Math.floor(elapsed / 60);
  const sec = elapsed % 60;
  el.textContent = m > 0 ? m + 'm ' + sec + 's' : sec + 's';
}
tickElapsed();
setInterval(tickElapsed, 1000);

// ─── Tabs ───────────────────────────────────────────────────────────
function switchTab(name) {
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.toggle('active', b.dataset.tab === name));
  document.querySelectorAll('.tab-pane').forEach(p => p.style.display = 'none');
  const pane = document.getElementById('pane-' + name);
  if (pane) pane.style.display = 'block';
}

// ─── Browser notification on verify ─────────────────────────────────
let _notified = false;
function checkNotification(s) {
  if (s.status === 'verify' && !_notified) {
    _notified = true;
    if (Notification.permission === 'granted') {
      new Notification('awf: Pipeline at verify', {
        body: s.todo_id + ' — ready for review',
        icon: 'data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">🔍</text></svg>'
      });
    }
  }
  if (s.status !== 'verify') _notified = false;
}
// Request permission on load
if ('Notification' in window && Notification.permission === 'default') {
  Notification.requestPermission();
}

// ─── Helpers ────────────────────────────────────────────────────────
function escapeHtml(s) {
  const d = document.createElement('div');
  d.textContent = s || '';
  return d.innerHTML;
}

// ─── Start polling ──────────────────────────────────────────────────
// Initial render from server-side state (first paint, no 3s wait)
const INITIAL_STATE = {{ initial_state_json | safe }};
updateAll(INITIAL_STATE);
// Then poll for live updates
setInterval(poll, 3000);
</script>

</body>
</html>
