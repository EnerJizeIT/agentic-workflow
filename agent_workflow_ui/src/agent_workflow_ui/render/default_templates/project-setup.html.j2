---
description: Setup form — context message, spec upload, supervisor role, agent team configuration
required_data_keys:
  - available_roles
optional_data_keys: []
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Настройка проекта</title>
  <style>
    :root {
      --bg: #1e1e1e;
      --bg-card: #252526;
      --bg-input: #3c3c3c;
      --bg-hover: #094771;
      --text: #d4d4d4;
      --text-muted: #858585;
      --accent: #569cd6;
      --accent-green: #4ec9b0;
      --border: #464647;
      --danger: #f14c4c;
      --radius: 6px;
      --spacing: 12px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, sans-serif;
      font-size: 14px;
      max-width: 680px;
      margin: 0 auto;
      padding: 32px 20px 60px;
      line-height: 1.5;
    }

    h1 {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 2px;
    }

    .page-hint {
      color: var(--text-muted);
      font-size: 13px;
      margin-bottom: 20px;
    }

    /* === Sections === */

    .section {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 16px 20px;
      margin-bottom: var(--spacing);
    }

    .section-title {
      color: var(--accent);
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 12px;
    }

    .section-title .req { color: var(--accent-green); }

    .section-hint {
      color: var(--text-muted);
      font-size: 12px;
      margin-bottom: 10px;
    }

    /* === Form elements === */

    .field { margin-bottom: 10px; }
    .field:last-child { margin-bottom: 0; }

    .field-label {
      display: block;
      font-size: 12px;
      color: var(--text-muted);
      margin-bottom: 4px;
    }

    input[type="text"], select, textarea {
      background: var(--bg-input);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 8px 10px;
      font-size: 13px;
      font-family: inherit;
      width: 100%;
      transition: border-color 0.15s;
    }

    input[type="text"]:focus, select:focus, textarea:focus {
      outline: none;
      border-color: var(--accent);
    }

    textarea { resize: vertical; min-height: 80px; }

    select { cursor: pointer; }
    select option, select optgroup { background: var(--bg-input); color: var(--text); }

    input[type="file"] { display: none; }

    input[type="checkbox"] { cursor: pointer; accent-color: var(--accent); }

    /* === Buttons === */

    .btn {
      background: var(--bg-input);
      color: var(--text-muted);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 7px 14px;
      font-size: 12px;
      font-family: inherit;
      cursor: pointer;
      transition: border-color 0.15s, color 0.15s;
      white-space: nowrap;
    }

    .btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .btn:disabled {
      opacity: 0.35;
      cursor: not-allowed;
    }

    .btn-add {
      background: transparent;
      color: var(--accent);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 7px 14px;
      font-size: 13px;
      cursor: pointer;
      font-family: inherit;
    }

    .btn-add:hover { background: var(--bg-input); border-color: var(--accent); }
    .btn-add:disabled { opacity: 0.35; cursor: not-allowed; }

    .btn-remove {
      background: none;
      border: none;
      color: var(--danger);
      font-size: 16px;
      cursor: pointer;
      padding: 4px;
      opacity: 0.5;
      line-height: 1;
    }

    .btn-remove:hover { opacity: 1; }

    .btn-reorder {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 14px;
      cursor: pointer;
      padding: 2px 5px;
      opacity: 0.5;
      line-height: 1;
    }

    .btn-reorder:hover { opacity: 1; color: var(--accent); }

    .btn-icon {
      background: none;
      border: none;
      color: var(--danger);
      font-size: 13px;
      cursor: pointer;
      padding: 2px 4px;
      opacity: 0.5;
    }

    .btn-icon:hover { opacity: 1; }

    .btn-submit {
      background: var(--accent-green);
      color: var(--bg);
      border: none;
      border-radius: var(--radius);
      padding: 12px;
      font-size: 15px;
      font-weight: 600;
      width: 100%;
      cursor: pointer;
      font-family: inherit;
      transition: opacity 0.2s;
    }

    .btn-submit:hover:not(:disabled) { filter: brightness(1.15); }
    .btn-submit:disabled { opacity: 0.35; cursor: not-allowed; background: var(--text-muted); }

    /* === File chips === */

    .chips { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 6px; }

    .chip {
      display: inline-flex;
      align-items: center;
      background: var(--bg-input);
      border: 1px solid var(--accent);
      border-radius: 12px;
      padding: 3px 8px 3px 10px;
      font-size: 12px;
      color: var(--accent);
      animation: chipIn 0.2s ease;
    }

    .chip-name {
      max-width: 160px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      margin-right: 4px;
    }

    .chip-close {
      background: none;
      border: none;
      color: var(--danger);
      font-size: 14px;
      cursor: pointer;
      padding: 0;
      line-height: 1;
    }

    @keyframes chipIn {
      from { opacity: 0; transform: translateY(-3px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* === Team table === */

    .team-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 8px;
    }

    .team-table th {
      text-align: left;
      color: var(--text-muted);
      font-size: 11px;
      text-transform: uppercase;
      padding: 6px 6px 6px 0;
      border-bottom: 1px solid var(--border);
      font-weight: normal;
      letter-spacing: 0.3px;
    }

    .team-table th:nth-last-child(2) { width: 48px; text-align: center; }
    .team-table th:last-child { width: 32px; text-align: center; }

    .team-table td {
      padding: 6px 6px 6px 0;
      border-bottom: 1px solid var(--border);
      vertical-align: middle;
    }

    .team-table td:nth-last-child(2) { width: 48px; text-align: center; }
    .team-table td:last-child { width: 32px; text-align: center; }
    .team-table tr:last-child td { border-bottom: none; }
    .team-table select, .team-table input[type="text"] { font-size: 12px; padding: 6px 8px; }

    .team-empty {
      text-align: center;
      color: var(--text-muted);
      font-size: 13px;
      padding: 16px 0;
      border-bottom: 1px solid var(--border);
    }

    /* === Custom agent inline === */

    .custom-agent-cell {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .custom-agent-cell .agent-name { flex: 1; min-width: 60px; }
    .custom-agent-cell .skill-zone { flex: 1; min-width: 60px; display: flex; align-items: center; gap: 4px; }
    .custom-agent-cell .save-cb { font-size: 11px; color: var(--text-muted); white-space: nowrap; }

    .upload-btn.hidden { display: none; }

    /* === Supervisor custom area === */

    .sv-custom-area { margin-top: 8px; display: none; }
    .sv-custom-area.visible { display: block; }

    .sv-custom-area .upload-row {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-bottom: 6px;
    }

    .sv-custom-area .save-label {
      font-size: 12px;
      color: var(--text-muted);
    }

    /* === Misc === */

    .team-actions { margin-top: 8px; }
    .hint { color: var(--text-muted); font-size: 11px; margin-top: 4px; }

    @media (max-width: 520px) {
      body { padding: 20px 12px 40px; }
      .section { padding: 12px 14px; }
      .custom-agent-cell { flex-wrap: wrap; }
      .custom-agent-cell .agent-name, .custom-agent-cell .skill-zone { min-width: 100%; }
    }
  </style>
</head>
<body>
  <h1>Настройка проекта</h1>
  <p class="page-hint">Опишите проект, выберите supervisor и соберите команду</p>

  <form action="{{ submit_url }}" method="POST" id="setup-form" novalidate>
    <input type="hidden" name="form_id" value="{{ form_id }}">
    <input type="hidden" name="team_config" id="team-config" value="">
    <input type="hidden" name="delete_agent" id="delete-agent-names" value="">

    {% set roles = available_roles or [] %}

    <!-- === Section 1: Контекст === -->
    <div class="section">
      <div class="section-title">Важный контекст о проекте</div>

      <div class="field">
        <textarea name="context_message" id="context_message" rows="4"
          placeholder="Опишите проект, цели, пожелания для supervisor..."></textarea>
      </div>

      <div class="field">
        <label class="btn" for="spec-file-input">📎 Прикрепить ТЗ</label>
        <input type="file" id="spec-file-input" multiple accept=".md,.txt">
        <div class="chips" id="spec-chips"></div>
        <input type="hidden" name="spec_files_json" id="spec-files-json" value="">
        <p class="hint">Markdown или текст. Можно несколько файлов.</p>
      </div>
    </div>

    <!-- === Section 2: Supervisor === -->
    <div class="section">
      <div class="section-title">Supervisor</div>

      <div class="field">
        <label for="supervisor_instruction">Дополнительная инструкция для supervisor</label>
        <textarea name="supervisor_instruction" id="supervisor_instruction" rows="4"
          placeholder="Например: фокус на безопасности, предпочитай Strategy pattern, commit message на русском..."></textarea>
        <p class="hint">Текст добавляется к supervisor.md как отдельная секция.</p>
      </div>

      <div class="field">
        <select name="supervisor_role" id="supervisor-select" onchange="handleSupervisorSelect(this)">
          <option value="">Default (универсальный)</option>
          {% for sv in (custom_supervisor_roles or []) %}
          <option value="{{ sv.id }}" data-custom="true">{{ sv.title }}</option>
          {% endfor %}
          <option value="__custom__">+ Загрузить свой .md...</option>
        </select>
      </div>

      <div class="sv-custom-area" id="sv-custom">
        <div class="upload-row">
          <label class="btn upload-btn" for="sv-file" id="sv-upload-btn">📎 .md файл</label>
          <input type="file" id="sv-file" accept=".md,.txt">
          <input type="hidden" name="supervisor_content" id="sv-content">
          <div class="chips" id="sv-chips"></div>
        </div>
        <label class="save-label">
          <input type="checkbox" name="save_supervisor" value="true"> Сохранить для будущих сессий
        </label>
      </div>

      <p class="hint">Инструкции ДОПОЛНЯЮТ default supervisor.md.</p>
    </div>

    <!-- === Section 3: Команда === -->
    <div class="section">
      <div class="section-title">Команда агентов <span class="req">*</span></div>
      <p class="section-hint">Добавьте агентов. Minimum 1. Порядок ролей = порядок pipeline.</p>

      <table class="team-table">
        <thead>
          <tr>
            <th>Агент</th>
            <th>Модель</th>
            <th></th>
            <th style="width: 48px; text-align: center;">Порядок</th>
          </tr>
        </thead>
        <tbody id="team-rows"></tbody>
      </table>

      <p class="team-empty" id="team-empty">Команда пуста — добавьте агентов</p>

      <div class="team-actions">
        <button type="button" class="btn-add" id="add-agent-btn" onclick="addRow()">+ Добавить агента</button>
      </div>
    </div>

    <button type="submit" class="btn-submit" id="submit-btn" disabled>Создать конфигурацию</button>
  </form>

  <script>
    (function () {
      {# AUD09-03: arrays are tojson literals — raw {{ }} interpolation broke
         the whole <script> (SyntaxError) on backslash/newline/quote in ids. #}
      var roles = {{ roles | tojson }};

      var allModels = {{ (available_models or []) | tojson }};

      var recentModels = {{ (recent_models or []) | tojson }};

      var customAgents = {{ (custom_agents or []) | tojson }};

      // UI-1: project-local roles (.agentic/roles/*.md, excluding supervisor)
      var projectRoles = {{ (project_roles or []) | tojson }};

      // BD-27: global skills with full content — primary source for team roles.
      var globalSkills = [
        {% for s in (global_skills or []) %}
        {id: {{ s.id | tojson }}, title: {{ s.title | tojson }}, desc: {{ s.get('description', '') | tojson }}, content: {{ s.content | tojson }}}{% if not loop.last %},{% endif %}
        {% endfor %}
      ];

      var existingSupervisorSlugs = {{ (existing_supervisor_slugs or []) | tojson }};

      var existingAgentSlugs = {{ (existing_agent_slugs or []) | tojson }};

      function slugify(name) {
        var m = {'а':'a','б':'b','в':'v','г':'g','д':'d','е':'e','ё':'e','ж':'zh','з':'z','и':'i','й':'y','к':'k','л':'l','м':'m','н':'n','о':'o','п':'p','р':'r','с':'s','т':'t','у':'u','ф':'f','х':'h','ц':'ts','ч':'ch','ш':'sh','щ':'sch','ъ':'','ы':'y','ь':'','э':'e','ю':'yu','я':'ya'};
        var s = (name || '').toLowerCase().split('').map(function(c) { return m[c] !== undefined ? m[c] : c; }).join('');
        s = s.replace(/[^a-z0-9_-]/g, '-').replace(/^-+|-+$/g, '');
        if (!s) throw new Error('No usable characters in role name: ' + name);
        return s;
      }

      var specFiles = [];
      var rowIdxCounter = 0;

      // === Helpers ===

      // A-16: options are built via DOM API — data (model names) is never
      // assembled into HTML strings; values go through textContent/value.
      function buildModelSelect() {
        var sel = document.createElement('select');
        sel.name = 'model';
        sel.className = 'model-select';
        if (recentModels.length > 0) {
          var recent = document.createElement('optgroup');
          recent.label = 'Recent';
          recentModels.forEach(function (m) {
            var o = document.createElement('option');
            o.value = m;
            o.textContent = m;
            recent.appendChild(o);
          });
          sel.appendChild(recent);
        }
        var all = document.createElement('optgroup');
        all.label = 'All models';
        if (allModels.length === 0) {
          var none = document.createElement('option');
          none.value = '';
          none.textContent = '(нет моделей)';
          all.appendChild(none);
        } else {
          allModels.forEach(function (m) {
            var o = document.createElement('option');
            o.value = m;
            o.textContent = m;
            all.appendChild(o);
          });
        }
        sel.appendChild(all);
        return sel;
      }

      function buildAgentSelect() {
        var sel = document.createElement('select');
        sel.name = 'agent';
        sel.className = 'agent-select';
        sel.onchange = function () { handleAgentSelect(sel); };
        // UI-1: 3 clean sections (user spec).
        // Section 1: previously used — merge project-local + global saved
        var seen = {};
        if (projectRoles.length > 0 || customAgents.length > 0) {
          var prev = document.createElement('optgroup');
          prev.label = 'Ранее использовавшиеся';
          projectRoles.forEach(function (r) {
            if (!seen[r.id]) {
              seen[r.id] = true;
              var o = document.createElement('option');
              o.value = r.id;
              o.setAttribute('data-kind', 'project');
              o.textContent = r.title;
              prev.appendChild(o);
            }
          });
          customAgents.forEach(function (c) {
            if (!seen[c.id]) {
              seen[c.id] = true;
              var o = document.createElement('option');
              o.value = c.id;
              o.setAttribute('data-custom', 'true');
              o.setAttribute('data-kind', 'custom');
              o.textContent = c.title;
              prev.appendChild(o);
            }
          });
          sel.appendChild(prev);
        }
        // Section 2: all skills (global ~/.config/opencode/skills/)
        if (globalSkills.length > 0) {
          var skills = document.createElement('optgroup');
          skills.label = 'Все скиллы';
          globalSkills.forEach(function (s) {
            var label = s.title + (s.desc ? ' — ' + s.desc.substring(0, 80) : '');
            if (label.length > 100) label = label.substring(0, 97) + '...';
            var o = document.createElement('option');
            o.value = s.id;
            o.setAttribute('data-kind', 'skill');
            o.textContent = label;
            skills.appendChild(o);
          });
          sel.appendChild(skills);
        }
        // Section 3: choose file
        var custom = document.createElement('option');
        custom.value = '__custom__';
        custom.setAttribute('data-kind', 'custom');
        custom.textContent = '+ Выбрать файл (.md)...';
        sel.appendChild(custom);
        return sel;
      }

      function clearNode(el) {
        while (el.firstChild) { el.removeChild(el.firstChild); }
      }

      function makeChip(name, onRemove) {
        var chip = document.createElement('span');
        chip.className = 'chip';
        var n = document.createElement('span');
        n.className = 'chip-name';
        n.textContent = '📎 ' + name;
        chip.appendChild(n);
        var x = document.createElement('button');
        x.type = 'button';
        x.className = 'chip-close';
        x.textContent = '×';
        x.onclick = function () { chip.remove(); if (onRemove) onRemove(); };
        chip.appendChild(x);
        return chip;
      }

      function buildSaveCheckbox() {
        var label = document.createElement('label');
        label.className = 'save-cb';
        var cb = document.createElement('input');
        cb.type = 'checkbox';
        cb.className = 'save-agent-cb';
        cb.checked = true;
        label.appendChild(cb);
        label.appendChild(document.createTextNode(' 💾'));
        return label;
      }

      function updateEmpty() {
        var empty = document.getElementById('team-empty');
        var rows = document.querySelectorAll('#team-rows .team-row');
        empty.style.display = rows.length > 0 ? 'none' : '';
      }

      function validate() {
        var rows = document.querySelectorAll('#team-rows .team-row');
        var hasTeam = rows.length > 0;
        var customOk = true;
        var hasIncomplete = false;

        rows.forEach(function (row) {
          if (row.classList.contains('custom-agent-row')) {
            var name = row.querySelector('.agent-name');
            var skill = row.querySelector('.skill-hidden');
            var nameOk = name && name.value.trim();
            var skillOk = skill && skill.value.trim();
            if (!nameOk || !skillOk) { customOk = false; hasIncomplete = true; }
          }
        });

        document.getElementById('submit-btn').disabled = !(hasTeam && customOk);

        var addBtn = document.getElementById('add-agent-btn');
        addBtn.disabled = hasIncomplete;
      }

      // === Team rows ===

       window.addRow = function () {
        var tbody = document.getElementById('team-rows');
        var tr = document.createElement('tr');
        tr.className = 'team-row';

        var tdAgent = document.createElement('td');
        tdAgent.appendChild(buildAgentSelect());

        var tdModel = document.createElement('td');
        tdModel.appendChild(buildModelSelect());

        var tdOrder = document.createElement('td');
        var up = document.createElement('button');
        up.type = 'button';
        up.className = 'btn-reorder team-up';
        up.title = 'Вверх';
        up.textContent = '▲';
        var down = document.createElement('button');
        down.type = 'button';
        down.className = 'btn-reorder team-down';
        down.title = 'Вниз';
        down.textContent = '▼';
        tdOrder.appendChild(up);
        tdOrder.appendChild(down);

        var tdRemove = document.createElement('td');
        var removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'btn-remove';
        removeBtn.textContent = '×';
        removeBtn.onclick = function () { removeRow(removeBtn); };
        tdRemove.appendChild(removeBtn);

        tr.appendChild(tdAgent);
        tr.appendChild(tdModel);
        tr.appendChild(tdOrder);
        tr.appendChild(tdRemove);
        tbody.appendChild(tr);
        updateEmpty();
        validate();
      };

      window.removeRow = function (btn) {
        btn.closest('tr').remove();
        updateEmpty();
        validate();
      };

      window.handleAgentSelect = function (sel) {
        var row = sel.closest('tr');
        var cell = row.cells[0];

        // BD-26-C: clean up any leftover inline editors
        cell.querySelectorAll('.skill-inline').forEach(function (b) { b.remove(); });

        var opt = sel.options[sel.selectedIndex];
        var kind = opt.dataset.kind || 'default';

        // BD-26-A: saved custom agents — no inline delete button (was causing
        // layout shift). User removes role via team-remove (× button in last
        // cell). To delete the persisted role entirely, use the dedicated
        // role-management form (not the project-setup form).

        // BD-27: selected a global skill → convert row to custom-agent-row
        // with skill content pre-filled (role name = skill title, editable)
        if (kind === 'skill') {
          var skill = null;
          for (var i = 0; i < globalSkills.length; i++) {
            if (globalSkills[i].id === sel.value) { skill = globalSkills[i]; break; }
          }
          if (!skill) return;
          row.classList.add('custom-agent-row', 'skill-row');
          // Replace cell with editable role-name input + skill chip.
          // A-16: skill.title/skill.content go through value/textContent —
          // they are data, never markup.
          clearNode(cell);
          var div = document.createElement('div');
          div.className = 'custom-agent-cell';
          var nameInput = document.createElement('input');
          nameInput.type = 'text';
          nameInput.className = 'agent-name';
          nameInput.name = 'custom_agent_name';
          nameInput.value = skill.title;
          nameInput.placeholder = 'Имя роли в pipeline';
          var skillZone = document.createElement('div');
          skillZone.className = 'skill-zone';
          var chip = document.createElement('span');
          chip.className = 'chip skill-inline';
          var chipName = document.createElement('span');
          chipName.className = 'chip-name';
          chipName.textContent = '\uD83E\uDDE9 ' + skill.title;
          chip.appendChild(chipName);
          skillZone.appendChild(chip);
          var hidden = document.createElement('input');
          hidden.type = 'hidden';
          hidden.className = 'skill-hidden';
          hidden.name = 'custom_agent_content';
          hidden.value = skill.content;
          skillZone.appendChild(hidden);
          div.appendChild(nameInput);
          div.appendChild(skillZone);
          div.appendChild(buildSaveCheckbox());
          cell.appendChild(div);
          validate();
          return;
        }

        if (sel.value !== '__custom__') return;

        // Convert to custom agent row (user uploads .md file)
        row.classList.add('custom-agent-row');
        var idx = rowIdxCounter++;
        clearNode(cell);
        var div = document.createElement('div');
        div.className = 'custom-agent-cell';
        var nameInput = document.createElement('input');
        nameInput.type = 'text';
        nameInput.className = 'agent-name';
        nameInput.name = 'custom_agent_name';
        nameInput.placeholder = 'Имя агента';
        var skillZone = document.createElement('div');
        skillZone.className = 'skill-zone';
        var uploadLabel = document.createElement('label');
        uploadLabel.className = 'btn upload-btn';
        uploadLabel.htmlFor = 'skill-' + idx;
        uploadLabel.textContent = '📎 .md';
        var fileInput = document.createElement('input');
        fileInput.type = 'file';
        fileInput.id = 'skill-' + idx;
        fileInput.accept = '.md,.txt';
        var hiddenContent = document.createElement('input');
        hiddenContent.type = 'hidden';
        hiddenContent.className = 'skill-hidden';
        hiddenContent.name = 'custom_agent_content';
        skillZone.appendChild(uploadLabel);
        skillZone.appendChild(fileInput);
        skillZone.appendChild(hiddenContent);
        div.appendChild(nameInput);
        div.appendChild(skillZone);
        div.appendChild(buildSaveCheckbox());
        cell.appendChild(div);

        fileInput.addEventListener('change', function (e) {
          var f = e.target.files[0];
          if (!f) return;
          uploadLabel.classList.add('hidden');
          var oldChips = skillZone.querySelectorAll('.chip');
          oldChips.forEach(function (c) { c.remove(); });
          skillZone.appendChild(makeChip(f.name, function () {
            hiddenContent.value = '';
            fileInput.value = '';
            uploadLabel.classList.remove('hidden');
            validate();
          }));
          var reader = new FileReader();
          reader.onload = function (ev) { hiddenContent.value = ev.target.result; validate(); };
          reader.readAsText(f);
          validate();
        });

        validate();
      };

      // === Spec files ===

      document.getElementById('spec-file-input').addEventListener('change', function (e) {
        var container = document.getElementById('spec-chips');
        Array.from(e.target.files).forEach(function (file) {
          var idx = specFiles.length;
          var reader = new FileReader();
          reader.onload = function (ev) {
            specFiles[idx] = { filename: file.name, content: ev.target.result };
            container.appendChild(makeChip(file.name, function () {
              specFiles[idx] = null;
              updateSpecJson();
              validate();
            }));
            updateSpecJson();
            validate();
          };
          reader.readAsText(file);
        });
        e.target.value = '';
      });

      function updateSpecJson() {
        var active = specFiles.filter(function (f) { return f !== null; });
        document.getElementById('spec-files-json').value = JSON.stringify(active);
      }

      // === Supervisor ===

      window.handleSupervisorSelect = function (sel) {
        var area = document.getElementById('sv-custom');
        // BD-26-C: no inline delete button (caused layout shift). Persisted
        // supervisor variants are managed elsewhere.

        var opt = sel.options[sel.selectedIndex];

        if (sel.value === '__custom__') {
          area.classList.add('visible');
          setTimeout(function () { document.getElementById('sv-file').click(); }, 50);
        } else {
          area.classList.remove('visible');
          document.getElementById('sv-content').value = '';
          clearNode(document.getElementById('sv-chips'));
          document.getElementById('sv-upload-btn').classList.remove('hidden');
        }
      };

      var svFile = document.getElementById('sv-file');
      var svContent = document.getElementById('sv-content');
      var svChips = document.getElementById('sv-chips');
      var svUploadBtn = document.getElementById('sv-upload-btn');

      svFile.addEventListener('change', function (e) {
        var f = e.target.files[0];
        if (!f) return;
        svUploadBtn.classList.add('hidden');
        clearNode(svChips);
        svChips.appendChild(makeChip(f.name, function () {
          svContent.value = '';
          svFile.value = '';
          svUploadBtn.classList.remove('hidden');
        }));
        var reader = new FileReader();
        reader.onload = function (ev) { svContent.value = ev.target.result; };
        reader.readAsText(f);
      });

      // === Submit ===

      document.getElementById('setup-form').addEventListener('submit', function (e) {
        // Conflict detection: confirm before overwriting existing custom roles
        var conflicts = [];

        // Check custom agents with save=true
        document.querySelectorAll('#team-rows .team-row').forEach(function (row) {
          var sel = row.querySelector('.agent-select');
          var nameInput = row.querySelector('.agent-name');
          var saveCb = row.querySelector('.save-agent-cb');

          if (nameInput && saveCb && saveCb.checked) {
            var name = nameInput.value.trim();
            if (name) {
              var slug = slugify(name);
              if (existingAgentSlugs.indexOf(slug) !== -1) {
                conflicts.push('Агент "' + name + '" (→ ' + slug + '.md)');
              }
            }
          }
        });

        // Check custom supervisor with save_supervisor=true
        var svSelect = document.getElementById('supervisor-select');
        var svContent = document.getElementById('sv-content');
        var saveSv = document.querySelector('input[name="save_supervisor"]');
        if (svContent && svContent.value.trim() && saveSv && saveSv.checked) {
          var firstLine = svContent.value.trim().split('\n')[0];
          var svName = firstLine.replace(/^#+\s*/, '').trim() || 'custom';
          var svSlug = slugify(svName);
          // Python save_custom_role adds 'supervisor-' prefix only if slug doesn't already have it.
          // Mirror that logic here to keep conflict detection in sync.
          if (svSlug.indexOf('supervisor-') !== 0) {
            svSlug = 'supervisor-' + svSlug;
          }
          if (existingSupervisorSlugs.indexOf(svSlug) !== -1) {
            conflicts.push('Supervisor "' + svName + '" (→ ' + svSlug + '.md)');
          }
        }

        if (conflicts.length > 0) {
          var msg = 'Следующие роли уже существуют:\n\n' + conflicts.join('\n') +
            '\n\nПерезаписать? Старое содержимое будет утрачено.';
          if (!confirm(msg)) {
            e.preventDefault();
            return;
          }
        }

        // Build team_config JSON
        var team = [];
        document.querySelectorAll('#team-rows .team-row').forEach(function (row) {
          var sel = row.querySelector('.agent-select');
          var nameInput = row.querySelector('.agent-name');
          var skillContent = row.querySelector('.skill-hidden');
          var skillInput = row.querySelector('input[type="file"]');
          var saveCb = row.querySelector('.save-agent-cb');

          if (sel && sel.value !== '__custom__') {
            team.push({ type: 'default', agent: sel.value, model: row.querySelector('.model-select').value });
          } else if (nameInput) {
            team.push({
              type: 'custom',
              agent: nameInput.value,
              skill_content: skillContent ? skillContent.value : '',
              skill_filename: skillInput && skillInput.files[0] ? skillInput.files[0].name : '',
              model: row.querySelector('.model-select').value,
              save: saveCb ? saveCb.checked : false,
            });
          }
        });
        document.getElementById('team-config').value = JSON.stringify(team);
      });

      // === Listeners ===

      document.addEventListener('input', validate);
      document.addEventListener('change', validate);
      document.getElementById('team-rows').addEventListener('input', validate);
      document.getElementById('team-rows').addEventListener('click', function (e) {
        var row = e.target.closest('.team-row');
        if (!row) return;
        if (e.target.classList.contains('team-up')) {
          var prev = row.previousElementSibling;
          if (prev) row.parentNode.insertBefore(row, prev);
        } else if (e.target.classList.contains('team-down')) {
          var next = row.nextElementSibling;
          if (next) row.parentNode.insertBefore(next, row);
        }
        validate();
      });

      validate();
    })();
  </script>
</body>
</html>
