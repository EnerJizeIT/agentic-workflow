---
description: Composite form for full awf project setup
required_data_keys:
  - available_roles
optional_data_keys:
  - available_skills
  - project_name
  - project_description
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Настройка проекта</title>
  <style>
    :root {
      --bg: #ffffff;
      --text: #1a1a1a;
      --text-muted: #666666;
      --border: #e0e0e0;
      --accent: #2563eb;
      --accent-hover: #1d4ed8;
      --bg-card: #f9fafb;
      --bg-input: #ffffff;
      --radius: 6px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      max-width: 640px;
      margin: 40px auto;
      padding: 0 20px;
      line-height: 1.5;
    }

    h1 {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .page-header {
      margin-bottom: 28px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }

    .page-header p {
      color: var(--text-muted);
      font-size: 14px;
    }

    fieldset {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
      margin-bottom: 16px;
    }

    legend {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      padding: 0 8px;
    }

    label {
      display: block;
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 4px;
      margin-top: 12px;
    }

    label:first-child { margin-top: 0; }

    input[type="text"],
    textarea,
    select {
      background: var(--bg-input);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 8px 12px;
      font-size: 14px;
      font-family: system-ui, -apple-system, sans-serif;
      width: 100%;
      transition: border-color 0.15s;
    }

    input[type="text"]:focus,
    textarea:focus,
    select:focus {
      outline: none;
      border-color: var(--accent);
    }

    textarea {
      resize: vertical;
      min-height: 60px;
    }

    /* Team table */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 12px;
    }

    th {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      color: var(--text-muted);
      text-align: left;
      padding: 0 8px 10px 8px;
      border-bottom: 1px solid var(--border);
    }

    td {
      padding: 8px 8px;
      vertical-align: middle;
      border-bottom: 1px solid var(--border);
    }

    tr:last-child td { border-bottom: none; }

    td:nth-child(4) {
      width: 1px;
      text-align: center;
    }

    td select {
      font-size: 13px;
      padding: 6px 8px;
    }

    input[type="checkbox"] {
      width: 16px;
      height: 16px;
      accent-color: var(--accent);
      cursor: pointer;
    }

    /* Radio buttons for pipeline */
    .radio-row {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 10px 12px;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin-top: 10px;
      cursor: pointer;
      transition: border-color 0.15s;
    }

    .radio-row:hover {
      border-color: var(--accent);
    }

    .radio-row input[type="radio"] {
      margin-top: 2px;
      cursor: pointer;
    }

    .radio-row strong {
      font-size: 14px;
    }

    .radio-row p {
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 2px;
    }

    /* Buttons */
    .btn-add {
      background: transparent;
      color: var(--accent);
      border: 1px dashed var(--accent);
      border-radius: 4px;
      padding: 6px 14px;
      font-size: 13px;
      cursor: pointer;
      margin-top: 10px;
      transition: all 0.15s;
    }

    .btn-add:hover {
      background: var(--bg-card);
    }

    .btn-remove {
      background: transparent;
      color: var(--text-muted);
      border: none;
      cursor: pointer;
      font-size: 16px;
      padding: 2px 6px;
      border-radius: 3px;
    }

    .btn-remove:hover {
      color: #dc2626;
    }

    .btn-submit {
      background: var(--accent);
      color: #ffffff;
      border: none;
      border-radius: var(--radius);
      padding: 12px 32px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
      font-family: system-ui, -apple-system, sans-serif;
    }

    .btn-submit:hover {
      background: var(--accent-hover);
    }

    .submit-section {
      text-align: center;
      margin-top: 28px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }

    .hint {
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 8px;
    }

    .inline-input {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .inline-input input[type="text"] { flex: 1; }
    .inline-input .btn-add { margin-top: 0; white-space: nowrap; }

    select option {
      background: var(--bg);
      color: var(--text);
    }
  </style>
</head>
<body>
  <div class="page-header">
    <h1>Настройка проекта</h1>
    <p>Заполните конфигурацию: команда, pipeline, команды проверки.</p>
  </div>

  <form action="{{ submit_url }}" method="POST" id="setup-form">
    <input type="hidden" name="form_id" value="{{ form_id }}">

    {% set roles = available_roles or [] %}
    {% set skills = available_skills or [] %}
    {% set models = available_models or [] %}

    <!-- Section 1: Project -->
    <fieldset>
      <legend>Project</legend>

      <label for="project_name">Название проекта</label>
      <input type="text" id="project_name" name="project_name"
        value="{{ project_name | default('', true) }}"
        required placeholder="internet-shop">

      <label for="project_description">Описание</label>
      <textarea id="project_description" name="project_description"
        placeholder="Краткое описание проекта...">{{ project_description | default('', true) }}</textarea>
    </fieldset>

    <!-- Section 2: Team -->
    <fieldset>
      <legend>Команда</legend>
      <p class="hint">Каждая строка — одна роль. Добавляйте и удаляйте по необходимости.</p>

      <table id="team-table">
        <thead>
          <tr>
            <th>Роль</th>
            <th>Специализация</th>
            <th>Модель</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="team-rows">
          <tr class="team-row">
            <td>
              <select name="role" class="role-select">
                {% for role in roles %}
                <option value="{{ role.id }}"{% if role.get('default') %} selected{% endif %}>
                  {{ role.title }}
                </option>
                {% endfor %}
              </select>
            </td>
            <td>
              <select name="skill" class="skill-select">
                <option value="">— выбрать —</option>
                {% for skill in skills %}
                <option value="{{ skill.id }}">{{ skill.title | default(skill.id, true) }}</option>
                {% endfor %}
              </select>
            </td>
            <td>
              <select name="model" class="model-select">
                {% if models %}
                  <option value="">— выбрать —</option>
                  {% for model in models %}
                  <option value="{{ model }}">{{ model }}</option>
                  {% endfor %}
                {% else %}
                  <option value="">нет моделей</option>
                {% endif %}
              </select>
            </td>
            <td>
              <button type="button" class="btn-remove" onclick="removeRow(this)">&times;</button>
            </td>
          </tr>
        </tbody>
      </table>

      <button type="button" class="btn-add" onclick="addRow()">+ Добавить роль</button>
    </fieldset>

    <!-- Section 3: Settings -->
    <fieldset>
      <legend>Настройки</legend>

      <label>Pipeline</label>
      <label class="radio-row">
        <input type="radio" name="pipeline" value="simple" checked>
        <div>
          <strong>Simple</strong>
          <p>plan &rarr; implement &rarr; verify</p>
        </div>
      </label>
      <label class="radio-row">
        <input type="radio" name="pipeline" value="full">
        <div>
          <strong>Full</strong>
          <p>plan &rarr; implement &rarr; review &rarr; test &rarr; verify</p>
        </div>
      </label>

      <label style="margin-top: 20px;">Команды проверки</label>
      <p class="hint" style="margin-top: 0;">Оставьте пустыми если не нужны.</p>

      <label for="test_cmd">Test</label>
      <input type="text" id="test_cmd" name="test_cmd" placeholder="pytest tests/">

      <label for="lint_cmd">Lint</label>
      <input type="text" id="lint_cmd" name="lint_cmd" placeholder="ruff check .">

      <label for="typecheck_cmd">Typecheck</label>
      <input type="text" id="typecheck_cmd" name="typecheck_cmd" placeholder="mypy src/">
    </fieldset>

    <input type="hidden" name="team_config" id="team-config" value="">

    <div class="submit-section">
      <button type="submit" class="btn-submit">Создать конфигурацию</button>
    </div>
  </form>

  <script>
    (function () {
      var allRoles = [
        {% for r in roles %}
        "{{ r.id }}"{% if not loop.last %},{% endif %}
        {% endfor %}
      ];
      var allSkills = [
        {% for s in skills %}
        {"id": "{{ s.id }}", "title": "{{ s.title | default(s.id, true) }}"}{% if not loop.last %},{% endif %}
        {% endfor %}
      ];
      var allModels = [
        {% for m in models %}
        "{{ m }}"{% if not loop.last %},{% endif %}
        {% endfor %}
      ];

      window.addRow = function () {
        var tbody = document.getElementById('team-rows');
        var firstRow = tbody.querySelector('.team-row');
        var newRow = firstRow.cloneNode(true);
        newRow.querySelectorAll('select').forEach(function (s) { s.selectedIndex = 0; });
        tbody.appendChild(newRow);
      };

      window.removeRow = function (button) {
        var row = button.closest('.team-row');
        var tbody = document.getElementById('team-rows');
        if (tbody.querySelectorAll('.team-row').length > 1) {
          row.remove();
        }
      };

      document.getElementById('setup-form').addEventListener('submit', function () {
        var rows = document.querySelectorAll('.team-row');
        var team = [];
        rows.forEach(function (row) {
          team.push({
            role: row.querySelector('.role-select').value,
            skill: row.querySelector('.skill-select').value,
            model: row.querySelector('.model-select').value,
          });
        });
        document.getElementById('team-config').value = JSON.stringify(team);
      });
    })();
  </script>
</body>
</html>
