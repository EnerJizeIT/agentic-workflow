---
description: Setup form — context message, spec upload, agent team configuration
required_data_keys:
  - available_roles
optional_data_keys: []
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Настройка проекта</title>
  <style>
    :root {
      --bg: #1e1e1e;
      --bg-card: #252526;
      --bg-input: #3c3c3c;
      --text: #d4d4d4;
      --text-muted: #858585;
      --accent: #569cd6;
      --accent-green: #4ec9b0;
      --accent-purple: #c586c0;
      --border: #464647;
      --danger: #f14c4c;
      --radius: 6px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, sans-serif;
      max-width: 720px;
      margin: 0 auto;
      padding: 32px 20px 60px;
      line-height: 1.5;
    }

    h1 {
      font-size: 22px;
      font-weight: 600;
      color: var(--text);
      margin-bottom: 4px;
    }

    .page-hint {
      color: var(--text-muted);
      font-size: 13px;
      margin-bottom: 24px;
    }

    fieldset {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
      margin-bottom: 16px;
    }

    legend {
      color: var(--accent);
      font-weight: 600;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 0 8px;
    }

    label {
      display: block;
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 4px;
      margin-top: 12px;
    }

    label:first-child { margin-top: 0; }

    input[type="text"],
    select,
    textarea {
      background: var(--bg-input);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 8px 12px;
      font-size: 14px;
      font-family: system-ui, -apple-system, sans-serif;
      width: 100%;
      transition: border-color 0.15s;
    }

    input[type="text"]:focus,
    select:focus,
    textarea:focus {
      outline: none;
      border-color: var(--accent);
    }

    select {
      min-width: 150px;
      cursor: pointer;
    }

    select option {
      background: var(--bg-input);
      color: var(--text);
    }

    input[type="file"] {
      display: none;
    }

    .file-upload-btn {
      display: inline-block;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 7px 14px;
      cursor: pointer;
      font-size: 13px;
      color: var(--text-muted);
      transition: border-color 0.15s, color 0.15s;
    }

    .file-upload-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .file-attachments {
      display: flex;
      flex-wrap: wrap;
      gap: 0;
      margin-top: 6px;
    }

    .file-chip {
      display: inline-flex;
      align-items: center;
      background: var(--bg-input);
      border: 1px solid var(--accent);
      border-radius: 16px;
      padding: 4px 10px 4px 12px;
      margin: 4px 4px 0 0;
      font-size: 12px;
      color: var(--accent);
      animation: fadeIn 0.2s ease;
    }

    .file-chip-name {
      margin-right: 6px;
      max-width: 180px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .file-chip-remove {
      background: none;
      border: none;
      color: var(--danger);
      font-size: 16px;
      line-height: 1;
      cursor: pointer;
      padding: 0 2px;
      opacity: 0.7;
      transition: opacity 0.15s;
    }

    .file-chip-remove:hover {
      opacity: 1;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 12px;
    }

    th {
      text-align: left;
      color: var(--text-muted);
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.3px;
      padding: 8px 8px 8px 0;
      border-bottom: 1px solid var(--border);
    }

    th:last-child {
      text-align: center;
      width: 36px;
    }

    td {
      padding: 6px 6px 6px 0;
      vertical-align: middle;
      border-bottom: 1px solid var(--border);
    }

    td:last-child {
      width: 36px;
      text-align: center;
    }

    tr:last-child td { border-bottom: none; }

    td select,
    td input[type="text"] {
      font-size: 13px;
      padding: 6px 8px;
    }

    .remove-btn {
      background: none;
      border: none;
      color: var(--danger);
      font-size: 18px;
      line-height: 1;
      cursor: pointer;
      padding: 4px;
      opacity: 0.6;
      transition: opacity 0.15s;
    }

    .remove-btn:hover {
      opacity: 1;
    }

    .empty-hint {
      text-align: center;
      color: var(--text-muted);
      font-size: 13px;
      padding: 20px 0;
      border-bottom: 1px solid var(--border);
    }

    .team-actions {
      display: flex;
      gap: 8px;
      margin-top: 12px;
      flex-wrap: wrap;
    }

    .team-actions button[type="button"] {
      background: transparent;
      color: var(--accent);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 7px 14px;
      cursor: pointer;
      font-size: 13px;
      font-family: system-ui, -apple-system, sans-serif;
      transition: background 0.15s, border-color 0.15s;
    }

    .team-actions button[type="button"]:hover {
      background: var(--bg-input);
      border-color: var(--accent);
    }

    button[type="submit"] {
      background: var(--accent-green);
      color: var(--bg);
      border: none;
      border-radius: var(--radius);
      padding: 12px 32px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      width: 100%;
      font-family: system-ui, -apple-system, sans-serif;
      margin-top: 8px;
      transition: opacity 0.2s, background 0.2s;
    }

    button[type="submit"]:hover:not(.disabled) {
      background: #6edbba;
    }

    button[type="submit"].disabled {
      opacity: 0.35;
      cursor: not-allowed;
      background: var(--text-muted);
    }

    .hint {
      color: var(--text-muted);
      font-size: 12px;
      margin: 6px 0 0 0;
    }

    .custom-agent-row td:first-child {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 6px;
    }

    .custom-agent-row .agent-input {
      flex: 1;
      min-width: 80px;
    }

    .custom-agent-row .skill-area {
      flex: 1;
      min-width: 80px;
    }

    .custom-agent-row .skill-upload-label {
      font-size: 12px;
      padding: 6px 10px;
      white-space: nowrap;
      width: 100%;
      text-align: center;
    }

    .custom-agent-row .skill-upload-label.hidden {
      display: none;
    }

    .custom-agent-row .skill-chip-container {
      flex: 1;
    }

    .section-hint {
      color: var(--text-muted);
      font-size: 12px;
      margin-top: 12px;
    }

    @media (max-width: 520px) {
      body { padding: 20px 12px 40px; }
      fieldset { padding: 14px; }
      .team-actions { flex-direction: column; }
      .team-actions button[type="button"] { width: 100%; text-align: center; }
      td, th { padding: 6px 4px 6px 0; font-size: 12px; }
    }
  </style>
</head>
<body>
  <h1>Настройка проекта</h1>
  <p class="page-hint">Опишите проект и соберите команду агентов</p>

  <form action="{{ submit_url }}" method="POST" id="setup-form" novalidate>
    <input type="hidden" name="form_id" value="{{ form_id }}">

    {% set roles = available_roles or [] %}

    <fieldset>
      <legend>Контекст</legend>

      <label for="context_message">Опишите проект, цели, пожелания</label>
      <textarea name="context_message" id="context_message" rows="5"
        placeholder="Например: Делаю интернет-магазин на Django. Нужен MVP за 2 недели. Фокус на backend и API..."></textarea>

      <label>Спецификация / ТЗ</label>
      <label for="spec-file-input" class="file-upload-btn">📎 Прикрепить файл(ы)</label>
      <input type="file" id="spec-file-input" multiple accept=".md,.txt">
      <div class="file-attachments" id="spec-attachments"></div>
      <input type="hidden" name="spec_files_json" id="spec-files-json" value="">
      <p class="hint">Можно прикрепить несколько файлов. Markdown или текст.</p>
    </fieldset>

    <fieldset>
      <legend>Supervisor</legend>

      <label>Дополнительная роль / инструкции для supervisor</label>
      <select name="supervisor_role" id="supervisor-select" onchange="handleSupervisorSelect(this)">
        <option value="">Default (универсальный supervisor)</option>
        {% for sv in (custom_supervisor_roles or []) %}
        <option value="{{ sv.id }}" data-custom="true">{{ sv.title }}</option>
        {% endfor %}
        <option value="__custom__">+ Загрузить свой .md...</option>
      </select>

      <div id="supervisor-custom-area" style="display:none; margin-top:8px;">
        <div style="display:flex; gap:6px; align-items:center;">
          <div class="skill-area" style="flex:1;">
            <label for="supervisor-file" class="file-upload-btn skill-upload-label" id="supervisor-upload-label">\uD83D\uDCCE .md</label>
            <input type="file" id="supervisor-file" accept=".md,.txt" style="display:none;">
            <input type="hidden" name="supervisor_content" id="supervisor-content">
            <span id="supervisor-chip-container" style="flex:1;"></span>
          </div>
        </div>
        <label style="margin-top:8px;">
          <input type="checkbox" name="save_supervisor" value="true">
          Сохранить для будущих сессий
        </label>
      </div>

      <p class="hint">Выбранные инструкции ДОПОЛНЯют default supervisor.md. Supervisor будет действовать по обеим.</p>
    </fieldset>

    <fieldset>
      <legend>Команда агентов <span style="color: var(--accent-green)">*</span></legend>
      <p class="section-hint">Добавьте агентов, которые будут работать над проектом. Minimum 1.</p>

      <table id="team-table">
        <thead>
          <tr>
            <th>Агент</th>
            <th>Модель</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="team-rows">
        </tbody>
      </table>
      <p class="empty-hint" id="empty-hint">Добавьте агентов в команду</p>

      <div class="team-actions">
        <button type="button" onclick="addRow()">+ Добавить агента</button>
      </div>
    </fieldset>

    <input type="hidden" name="team_config" id="team-config" value="">
    <input type="hidden" name="delete_agent" id="delete-agent-names" value="">

    <button type="submit" class="disabled" id="submit-btn">Создать конфигурацию</button>
  </form>

  <script>
    (function () {
      var allRoles = [
        {% for role in roles %}
        {id: "{{ role.id }}", title: "{{ role.title }}", desc: "{{ role.get('description', '') }}"}{% if not loop.last %},{% endif %}
        {% endfor %}
      ];

      var allModels = [
        {% for m in (available_models or []) %}
        "{{ m }}"{% if not loop.last %},{% endif %}
        {% endfor %}
      ];

      var recentModels = [
        {% for m in (recent_models or []) %}
        "{{ m }}"{% if not loop.last %},{% endif %}
        {% endfor %}
      ];

      var specFiles = [];

      function buildModelOptions() {
        var opts = '';
        if (recentModels.length > 0) {
          opts += '<optgroup label="Recent">';
          for (var i = 0; i < recentModels.length; i++) {
            opts += '<option value="' + recentModels[i] + '">' + recentModels[i] + '</option>';
          }
          opts += '</optgroup>';
        }
        opts += '<optgroup label="All models">';
        if (allModels.length === 0) {
          opts += '<option value="">(нет моделей)</option>';
        } else {
          for (var i = 0; i < allModels.length; i++) {
            opts += '<option value="' + allModels[i] + '">' + allModels[i] + '</option>';
          }
        }
        opts += '</optgroup>';
        return opts;
      }

      var customAgents = [
        {% for ca in (custom_agents or []) %}
        {id: "{{ ca.id }}", title: "{{ ca.title }}"}{% if not loop.last %},{% endif %}
        {% endfor %}
      ];

      function buildAgentSelect(onchange) {
        var s = '<select name="agent" class="agent-select" onchange="' + onchange + '">';
        for (var i = 0; i < allRoles.length; i++) {
          var r = allRoles[i];
          var label = r.title + (r.desc ? ' \u2014 ' + r.desc : '');
          s += '<option value="' + r.id + '">' + label + '</option>';
        }
        if (customAgents.length > 0) {
          s += '<optgroup label="Мои агенты">';
          for (var i = 0; i < customAgents.length; i++) {
            s += '<option value="' + customAgents[i].id + '" data-custom="true">' + customAgents[i].title + '</option>';
          }
          s += '</optgroup>';
        }
        s += '<option value="__custom__">+ Свой агент...</option>';
        s += '</select>';
        return s;
      }

      function updateEmptyHint() {
        var rows = document.querySelectorAll('.team-row');
        var hint = document.getElementById('empty-hint');
        if (hint) {
          hint.style.display = rows.length > 0 ? 'none' : '';
        }
      }

      function validateForm() {
        var hasTeam = document.querySelectorAll('.team-row').length > 0;

        // Check custom agents have name + skill filled
        var customRows = document.querySelectorAll('.custom-agent-row');
        var customValid = true;
        var hasIncompleteCustom = false;
        customRows.forEach(function(row) {
          var nameInput = row.querySelector('.agent-input');
          var skillContent = row.querySelector('.skill-content');
          var nameFilled = nameInput && nameInput.value.trim();
          var skillFilled = skillContent && skillContent.value.trim();
          if (!nameFilled || !skillFilled) {
            customValid = false;
            hasIncompleteCustom = true;
          }
        });

        var valid = hasTeam && customValid;
        var btn = document.getElementById('submit-btn');
        if (valid) {
          btn.disabled = false;
          btn.classList.remove('disabled');
        } else {
          btn.disabled = true;
          btn.classList.add('disabled');
        }

        // Disable "Add agent" button while custom agent is incomplete
        var addBtn = document.querySelector('.team-actions button[type="button"]');
        if (addBtn) {
          if (hasIncompleteCustom) {
            addBtn.disabled = true;
            addBtn.style.opacity = '0.4';
            addBtn.style.cursor = 'not-allowed';
          } else {
            addBtn.disabled = false;
            addBtn.style.opacity = '';
            addBtn.style.cursor = '';
          }
        }
      }

      document.addEventListener('input', validateForm);
      document.addEventListener('change', validateForm);

      // Also validate when custom agent fields change
      document.getElementById('team-rows').addEventListener('input', validateForm);
      document.getElementById('team-rows').addEventListener('change', validateForm);

      window.addRow = function () {
        var tbody = document.getElementById('team-rows');
        var row = document.createElement('tr');
        row.className = 'team-row';
        row.innerHTML =
          '<td>' + buildAgentSelect('handleAgentSelect(this)') + '</td>' +
          '<td><select name="model" class="model-select">' + buildModelOptions() + '</select></td>' +
          '<td><button type="button" class="remove-btn" onclick="removeRow(this)">&times;</button></td>';
        tbody.appendChild(row);
        updateEmptyHint();
        validateForm();
      };

      window.handleAgentSelect = function (sel) {
        // Check if a saved custom agent was selected
        var selectedOpt = sel.options[sel.selectedIndex];
        if (selectedOpt && selectedOpt.dataset.custom === 'true' && sel.value !== '__custom__') {
          // Show delete button next to the select
          var row = sel.closest('.team-row');
          var agentTd = row.cells[0];
          // Remove existing delete button
          var existingDel = agentTd.querySelector('.delete-agent-btn');
          if (existingDel) existingDel.remove();
          // Add delete button
          var delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'remove-btn delete-agent-btn';
          delBtn.title = 'Удалить из сохранённых';
          delBtn.style.cssText = 'font-size:13px; color:var(--danger); opacity:0.6; border:none; background:none; cursor:pointer; margin-left:4px;';
          delBtn.textContent = '\uD83D\uDDD1';
          delBtn.onclick = function() {
            if (confirm('Удалить агента "' + selectedOpt.textContent + '" из сохранённых?')) {
              // Set hidden field for deletion on submit
              var existing = document.getElementById('delete-agent-names');
              var names = existing.value ? existing.value.split(',') : [];
              names.push(sel.value);
              existing.value = names.join(',');
              // Remove from dropdown
              selectedOpt.remove();
              // Reset select to first option
              sel.selectedIndex = 0;
              delBtn.remove();
              validateForm();
            }
          };
          sel.parentElement.appendChild(delBtn);
          return;
        }

        // Remove delete button if switching away from custom agent
        var row = sel.closest('.team-row');
        var existingDel = row.querySelector('.delete-agent-btn');
        if (existingDel) existingDel.remove();

        if (sel.value !== '__custom__') return;
        var row = sel.closest('.team-row');
        var agentTd = row.cells[0];

        var existingInput = agentTd.querySelector('.agent-input');
        if (existingInput) return;

        var rowIdx = rowIdxCounter++;
        row.classList.add('custom-agent-row');
        agentTd.innerHTML =
          '<input type="text" name="custom_agent_name" class="agent-input" placeholder="Имя агента" required>' +
          '<div class="skill-area">' +
            '<label for="skill-file-' + rowIdx + '" class="file-upload-btn skill-upload-label">\uD83D\uDCCE .md</label>' +
            '<input type="file" id="skill-file-' + rowIdx + '" name="custom_agent_skill" accept=".md,.txt" class="skill-file">' +
            '<input type="hidden" name="custom_agent_content" class="skill-content">' +
            '<span class="skill-chip-container"></span>' +
          '</div>' +
          '<label class="save-checkbox" style="font-size:11px; white-space:nowrap;">' +
            '<input type="checkbox" name="save_custom_agent" class="save-agent-cb" value="true" checked> \uD83D\uDCBE' +
          '</label>';

        var fileInput = agentTd.querySelector('.skill-file');
        var hiddenContent = agentTd.querySelector('.skill-content');
        var chipContainer = agentTd.querySelector('.skill-chip-container');
        var uploadLabel = agentTd.querySelector('.skill-upload-label');

        fileInput.addEventListener('change', function (e) {
          var file = e.target.files[0];
          if (!file) return;
          // Hide upload button, show chip
          uploadLabel.classList.add('hidden');
          chipContainer.innerHTML = '<span class="file-chip">' +
            '<span class="file-chip-name">\uD83D\uDCCE ' + file.name + '</span>' +
            '<button type="button" class="file-chip-remove" onclick="removeSkillFile(this)">&times;</button>' +
            '</span>';
          var reader = new FileReader();
          reader.onload = function (ev) {
            hiddenContent.value = ev.target.result;
            validateForm();
          };
          reader.readAsText(file);
          validateForm();
        });

        // Expose removeSkillFile for chip remove → restore upload button
        window.removeSkillFile = function(btn) {
          chipContainer.innerHTML = '';
          hiddenContent.value = '';
          fileInput.value = '';
          uploadLabel.classList.remove('hidden');
          validateForm();
        };

        validateForm();
      };

      var rowIdxCounter = 0;

      window.removeRow = function (button) {
        var row = button.closest('.team-row');
        row.remove();
        updateEmptyHint();
        validateForm();
      };

      document.getElementById('spec-file-input').addEventListener('change', function (e) {
        var chosen = Array.from(e.target.files);
        var container = document.getElementById('spec-attachments');
        chosen.forEach(function (file) {
          var idx = specFiles.length;
          var reader = new FileReader();
          reader.onload = function (ev) {
            specFiles[idx] = { filename: file.name, content: ev.target.result };
            var chip = document.createElement('span');
            chip.className = 'file-chip';
            chip.id = 'spec-chip-' + idx;
            var removeIdx = idx;
            chip.innerHTML = '<span class="file-chip-name">\uD83D\uDCCE ' + file.name + '</span>' +
              '<button type="button" class="file-chip-remove" onclick="removeSpecFile(' + removeIdx + ', this)">&times;</button>';
            container.appendChild(chip);
            updateSpecJson();
            validateForm();
          };
          reader.readAsText(file);
        });
        e.target.value = '';
      });

      window.removeSpecFile = function (idx, btn) {
        specFiles[idx] = null;
        btn.parentElement.remove();
        updateSpecJson();
        validateForm();
      };

      function updateSpecJson() {
        var active = specFiles.filter(function (f) { return f !== null; });
        document.getElementById('spec-files-json').value = JSON.stringify(active);
      }

      document.getElementById('setup-form').addEventListener('submit', function () {
        var rows = document.querySelectorAll('.team-row');
        var team = [];
        rows.forEach(function (row) {
          var agentSelect = row.querySelector('.agent-select');
          var agentInput = row.querySelector('.agent-input');
          var skillContent = row.querySelector('.skill-content');
          var skillFile = row.querySelector('.skill-file');

          if (agentSelect && agentSelect.value !== '__custom__') {
            team.push({
              type: 'default',
              agent: agentSelect.value,
              model: row.querySelector('.model-select').value,
            });
          } else if (agentInput) {
            var saveCb = row.querySelector('.save-agent-cb');
            team.push({
              type: 'custom',
              agent: agentInput.value,
              skill_content: skillContent ? skillContent.value : '',
              skill_filename: skillFile && skillFile.files[0] ? skillFile.files[0].name : '',
              model: row.querySelector('.model-select').value,
              save: saveCb ? saveCb.checked : false,
            });
          }
        });
        document.getElementById('team-config').value = JSON.stringify(team);
      });

      // === Supervisor section ===

      window.handleSupervisorSelect = function (sel) {
        var area = document.getElementById('supervisor-custom-area');

        // Remove existing delete button
        var existingDel = sel.parentElement.querySelector('.delete-sv-btn');
        if (existingDel) existingDel.remove();

        // Check if a saved custom supervisor was selected
        var selectedOpt = sel.options[sel.selectedIndex];
        if (selectedOpt && selectedOpt.dataset.custom === 'true' && sel.value !== '__custom__') {
          // Show delete button
          var delBtn = document.createElement('button');
          delBtn.type = 'button';
          delBtn.className = 'delete-sv-btn';
          delBtn.title = 'Удалить из сохранённых';
          delBtn.style.cssText = 'font-size:13px; color:var(--danger); opacity:0.6; border:none; background:none; cursor:pointer; margin-left:4px;';
          delBtn.textContent = '\uD83D\uDDD1';
          delBtn.onclick = function() {
            if (confirm('Удалить supervisor роль "' + selectedOpt.textContent + '"?')) {
              var existing = document.getElementById('delete-agent-names');
              var names = existing.value ? existing.value.split(',') : [];
              names.push(sel.value);
              existing.value = names.join(',');
              selectedOpt.remove();
              sel.selectedIndex = 0;
              delBtn.remove();
            }
          };
          sel.parentElement.appendChild(delBtn);
        }

        if (sel.value === '__custom__') {
          area.style.display = 'block';
          setTimeout(function() { document.getElementById('supervisor-file').click(); }, 50);
        } else {
          area.style.display = 'none';
          document.getElementById('supervisor-content').value = '';
          document.getElementById('supervisor-chip-container').innerHTML = '';
          document.getElementById('supervisor-upload-label').classList.remove('hidden');
        }
      };

      // Supervisor file handler
      var svFile = document.getElementById('supervisor-file');
      var svContent = document.getElementById('supervisor-content');
      var svChipContainer = document.getElementById('supervisor-chip-container');
      var svUploadLabel = document.getElementById('supervisor-upload-label');

      svFile.addEventListener('change', function (e) {
        var file = e.target.files[0];
        if (!file) return;
        svUploadLabel.classList.add('hidden');
        svChipContainer.innerHTML = '<span class="file-chip">' +
          '<span class="file-chip-name">\uD83D\uDCCE ' + file.name + '</span>' +
          '<button type="button" class="file-chip-remove" onclick="removeSupervisorFile()">&times;</button>' +
          '</span>';
        var reader = new FileReader();
        reader.onload = function (ev) {
          svContent.value = ev.target.result;
        };
        reader.readAsText(file);
      });

      window.removeSupervisorFile = function () {
        svChipContainer.innerHTML = '';
        svContent.value = '';
        svFile.value = '';
        svUploadLabel.classList.remove('hidden');
      };

      validateForm();
    })();
  </script>
</body>
</html>