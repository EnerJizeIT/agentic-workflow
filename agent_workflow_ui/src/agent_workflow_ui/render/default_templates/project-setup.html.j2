---
description: Setup form for awf project — agents, models, spec upload
required_data_keys:
  - available_roles
optional_data_keys:
  - project_name
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Настройка проекта</title>
  <style>
    :root {
      --bg: #1e1e1e;
      --bg-card: #252526;
      --bg-input: #3c3c3c;
      --text: #d4d4d4;
      --text-muted: #858585;
      --accent: #569cd6;
      --accent-green: #4ec9b0;
      --border: #464647;
      --radius: 6px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: system-ui, -apple-system, sans-serif;
      background: var(--bg);
      color: var(--text);
      max-width: 640px;
      margin: 40px auto;
      padding: 0 20px;
      line-height: 1.5;
    }

    h1 {
      font-size: 24px;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .page-header {
      margin-bottom: 28px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border);
    }

    .page-header p {
      color: var(--text-muted);
      font-size: 14px;
    }

    fieldset {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
      margin-bottom: 16px;
    }

    legend {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: var(--text-muted);
      padding: 0 8px;
    }

    label {
      display: block;
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 4px;
      margin-top: 12px;
    }

    label:first-child { margin-top: 0; }

    input[type="text"],
    input[type="file"],
    select {
      background: var(--bg-input);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 8px 12px;
      font-size: 14px;
      font-family: system-ui, -apple-system, sans-serif;
      width: 100%;
      transition: border-color 0.15s;
    }

    input[type="text"]:focus,
    select:focus {
      outline: none;
      border-color: var(--accent);
    }

    input[type="file"] {
      padding: 6px 8px;
      cursor: pointer;
    }

    /* Team table */
    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 12px;
    }

    th {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.4px;
      color: var(--text-muted);
      text-align: left;
      padding: 0 8px 10px 8px;
      border-bottom: 1px solid var(--border);
    }

    td {
      padding: 8px 8px;
      vertical-align: middle;
      border-bottom: 1px solid var(--border);
    }

    tr:last-child td { border-bottom: none; }

    td:last-child {
      width: 1px;
      text-align: center;
    }

    td select,
    td input[type="text"] {
      font-size: 13px;
      padding: 6px 8px;
    }

    .btn-add {
      background: transparent;
      color: var(--accent);
      border: 1px dashed var(--accent);
      border-radius: 4px;
      padding: 6px 14px;
      font-size: 13px;
      cursor: pointer;
      margin-top: 10px;
      transition: all 0.15s;
      font-family: system-ui, -apple-system, sans-serif;
    }

    .btn-add:hover {
      background: var(--bg-input);
    }

    .btn-add-custom {
      background: transparent;
      color: var(--accent-green);
      border: 1px dashed var(--accent-green);
      border-radius: 4px;
      padding: 6px 14px;
      font-size: 13px;
      cursor: pointer;
      margin-top: 10px;
      margin-left: 8px;
      transition: all 0.15s;
      font-family: system-ui, -apple-system, sans-serif;
    }

    .btn-add-custom:hover {
      background: var(--bg-input);
    }

    .btn-remove {
      background: transparent;
      color: var(--text-muted);
      border: none;
      cursor: pointer;
      font-size: 18px;
      padding: 2px 6px;
      border-radius: 3px;
      line-height: 1;
    }

    .btn-remove:hover {
      color: #f44747;
    }

    .btn-submit {
      background: var(--accent);
      color: #ffffff;
      border: none;
      border-radius: var(--radius);
      padding: 12px 32px;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
      font-family: system-ui, -apple-system, sans-serif;
    }

    .btn-submit:hover {
      background: #4a8cc7;
    }

    .submit-section {
      text-align: center;
      margin-top: 28px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
    }

    .hint {
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 8px;
    }

    select option {
      background: var(--bg-input);
      color: var(--text);
    }
  </style>
</head>
<body>
  <div class="page-header">
    <h1>Настройка проекта</h1>
    <p>Укажите название проекта, загрузите спецификацию и соберите команду агентов.</p>
  </div>

  <form action="{{ submit_url }}" method="POST" id="setup-form" enctype="multipart/form-data">
    <input type="hidden" name="form_id" value="{{ form_id }}">

    {% set roles = available_roles or [] %}
    {% set models = available_models or [] %}

    <!-- Section 1: Project -->
    <fieldset>
      <legend>Project</legend>

      <label for="project_name">Название проекта</label>
      <input type="text" id="project_name" name="project_name"
        value="{{ project_name | default('', true) }}"
        required placeholder="internet-shop">

      <label for="spec_file">Спецификация / ТЗ (опционально)</label>
      <input type="file" id="spec_file" name="spec_file" accept=".md,.txt,.pdf,.docx">
      <input type="hidden" name="spec_content" id="spec_content" value="">
      <input type="hidden" name="spec_filename" id="spec_filename" value="">
      <p class="hint">Загрузите markdown или текстовый файл с описанием проекта.</p>
    </fieldset>

    <!-- Section 2: Team -->
    <fieldset>
      <legend>Команда</legend>
      <p class="hint">Каждая строка — один агент. Добавляйте и удаляйте по необходимости.</p>

      <table id="team-table">
        <thead>
          <tr>
            <th>Агент</th>
            <th>Модель</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="team-rows">
          <tr class="team-row">
            <td>
              <select name="agent" class="agent-select">
                {% for agent in roles %}
                <option value="{{ agent.id }}"{% if agent.get('default') %} selected{% endif %}>
                  {{ agent.title }}
                </option>
                {% endfor %}
              </select>
            </td>
            <td>
              <select name="model" class="model-select">
                {% if models %}
                  {% for model in models %}
                  <option value="{{ model }}">{{ model }}</option>
                  {% endfor %}
                {% else %}
                  <option value="">нет моделей</option>
                {% endif %}
              </select>
            </td>
            <td>
              <button type="button" class="btn-remove" onclick="removeRow(this)">&times;</button>
            </td>
          </tr>
        </tbody>
      </table>

      <button type="button" class="btn-add" onclick="addRow()">+ Добавить агента</button>
      <button type="button" class="btn-add-custom" onclick="addCustomAgent()">+ Свой агент</button>
    </fieldset>

    <input type="hidden" name="team_config" id="team-config" value="">

    <div class="submit-section">
      <button type="submit" class="btn-submit">Создать конфигурацию</button>
    </div>
  </form>

  <script>
    (function () {
      var allModels = [
        {% for m in models %}
        "{{ m }}"{% if not loop.last %},{% endif %}
        {% endfor %}
      ];

      window.addRow = function () {
        var tbody = document.getElementById('team-rows');
        var firstRow = tbody.querySelector('.team-row');
        if (!firstRow) return;
        var newRow = firstRow.cloneNode(true);
        newRow.querySelectorAll('select').forEach(function (s) { s.selectedIndex = 0; });
        tbody.appendChild(newRow);
      };

      window.addCustomAgent = function () {
        var tbody = document.getElementById('team-rows');
        var row = document.createElement('tr');
        row.className = 'team-row';
        var modelOptions = '';
        allModels.forEach(function (m) {
          modelOptions += '<option value="' + m + '">' + m + '</option>';
        });
        row.innerHTML =
          '<td><input type="text" name="custom_agent" class="agent-input" placeholder="Например: Security Auditor"></td>' +
          '<td><select name="model" class="model-select">' + modelOptions + '</select></td>' +
          '<td><button type="button" class="btn-remove" onclick="removeRow(this)">&times;</button></td>';
        tbody.appendChild(row);
      };

      window.removeRow = function (button) {
        var row = button.closest('.team-row');
        var tbody = document.getElementById('team-rows');
        if (tbody.querySelectorAll('.team-row').length > 1) {
          row.remove();
        }
      };

      document.getElementById('spec_file').addEventListener('change', function (e) {
        var file = e.target.files[0];
        if (!file) return;
        document.getElementById('spec_filename').value = file.name;
        var reader = new FileReader();
        reader.onload = function (ev) {
          document.getElementById('spec_content').value = ev.target.result;
        };
        reader.readAsText(file);
      });

      document.getElementById('setup-form').addEventListener('submit', function () {
        var rows = document.querySelectorAll('.team-row');
        var team = [];
        rows.forEach(function (row) {
          var agentSelect = row.querySelector('.agent-select');
          var agentInput = row.querySelector('.agent-input');
          var agentName = agentSelect ? agentSelect.value : (agentInput ? agentInput.value.trim() : '');
          team.push({
            agent: agentName,
            model: row.querySelector('.model-select').value,
          });
        });
        document.getElementById('team-config').value = JSON.stringify(team);
      });
    })();
  </script>
</body>
</html>
