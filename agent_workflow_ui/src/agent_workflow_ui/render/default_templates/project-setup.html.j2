---
description: Setup form — context message, spec upload, agent team configuration
required_data_keys:
  - available_roles
optional_data_keys: []
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Настройка проекта</title>
  <style>
    :root {
      --bg: #1e1e1e;
      --bg-card: #252526;
      --bg-input: #3c3c3c;
      --text: #d4d4d4;
      --text-muted: #858585;
      --accent: #569cd6;
      --accent-green: #4ec9b0;
      --accent-purple: #c586c0;
      --border: #464647;
      --danger: #f14c4c;
      --radius: 6px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: system-ui, -apple-system, sans-serif;
      max-width: 700px;
      margin: 40px auto;
      padding: 0 20px;
      line-height: 1.5;
    }

    fieldset {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
      margin-bottom: 16px;
    }

    legend {
      color: var(--accent);
      font-weight: 600;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 0 8px;
    }

    label {
      display: block;
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 4px;
      margin-top: 12px;
    }

    label:first-child { margin-top: 0; }

    input[type="text"],
    select,
    textarea {
      background: var(--bg-input);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 8px 12px;
      font-size: 14px;
      font-family: system-ui, -apple-system, sans-serif;
      width: 100%;
      transition: border-color 0.15s;
    }

    input[type="text"]:focus,
    select:focus,
    textarea:focus {
      outline: none;
      border-color: var(--accent);
    }

    input[type="file"] {
      color: var(--text-muted);
      font-size: 14px;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 12px;
    }

    th {
      text-align: left;
      color: var(--text-muted);
      font-size: 12px;
      text-transform: uppercase;
      padding: 8px;
      border-bottom: 1px solid var(--border);
    }

    td {
      padding: 8px;
      vertical-align: middle;
      border-bottom: 1px solid var(--border);
    }

    tr:last-child td { border-bottom: none; }

    td:last-child {
      width: 1px;
      text-align: center;
    }

    td select,
    td input[type="text"] {
      font-size: 13px;
      padding: 6px 8px;
    }

    .remove-btn {
      background: none;
      border: none;
      color: var(--danger);
      font-size: 18px;
      cursor: pointer;
      padding: 4px 8px;
    }

    .remove-btn:hover {
      color: #ff6b6b;
    }

    button[type="button"] {
      background: transparent;
      color: var(--accent);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 8px 16px;
      cursor: pointer;
      font-size: 14px;
      font-family: system-ui, -apple-system, sans-serif;
    }

    button[type="button"]:hover {
      background: var(--bg-input);
    }

    button[type="submit"] {
      background: var(--accent-green);
      color: var(--bg);
      border: none;
      border-radius: var(--radius);
      padding: 12px 32px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      width: 100%;
      font-family: system-ui, -apple-system, sans-serif;
    }

    button[type="submit"]:hover {
      background: #6edbba;
    }

    .hint {
      color: var(--text-muted);
      font-size: 12px;
      margin: 4px 0 12px 0;
    }

    .team-actions {
      display: flex;
      gap: 8px;
      margin-top: 12px;
    }

    .custom-agent-row .agent-input {
      margin-bottom: 4px;
    }

    .custom-agent-row .skill-file {
      font-size: 12px;
    }

    select option {
      background: var(--bg-input);
      color: var(--text);
    }
  </style>
</head>
<body>
  <form action="{{ submit_url }}" method="POST" id="setup-form" enctype="multipart/form-data">
    <input type="hidden" name="form_id" value="{{ form_id }}">

    {% set roles = available_roles or [] %}

    <fieldset>
      <legend>Контекст</legend>

      <label for="context_message">Опишите проект, цели, пожелания</label>
      <textarea name="context_message" id="context_message" rows="5"
        placeholder="Например: Делаю интернет-магазин на Django. Нужен MVP за 2 недели. Фокус на backend и API. Команда из 2 человек..."></textarea>

      <label for="spec-file">Спецификация / ТЗ (опционально)</label>
      <input type="file" name="spec_file" accept=".md,.txt" id="spec-file">
      <input type="hidden" name="spec_content" id="spec-content">
      <input type="hidden" name="spec_filename" id="spec-filename">
      <p class="hint">Загрузите markdown или текстовый файл с описанием проекта.</p>
    </fieldset>

    <fieldset>
      <legend>Команда агентов</legend>

      <table id="team-table">
        <thead>
          <tr>
            <th>Агент</th>
            <th>Модель</th>
            <th></th>
          </tr>
        </thead>
        <tbody id="team-rows">
          <tr class="team-row">
            <td>
              <select name="agent" class="agent-select">
                {% for role in roles %}
                <option value="{{ role.id }}"{% if role.get('default') %} selected{% endif %}>
                  {{ role.title }} — {{ role.get('description', '') }}
                </option>
                {% endfor %}
              </select>
            </td>
            <td>
               <select name="model" class="model-select">
                 {% if recent_models %}
                 <optgroup label="Recent">
                   {% for model in recent_models %}
                   <option value="{{ model }}">{{ model }}</option>
                   {% endfor %}
                 </optgroup>
                 {% endif %}
                 <optgroup label="All models">
                   {% for model in (available_models or []) %}
                   <option value="{{ model }}">{{ model }}</option>
                   {% endfor %}
                 </optgroup>
               </select>
             </td>
            <td>
              <button type="button" class="remove-btn" onclick="removeRow(this)">&times;</button>
            </td>
          </tr>
        </tbody>
      </table>

      <div class="team-actions">
        <button type="button" onclick="addRow()">+ Добавить агента</button>
        <button type="button" onclick="addCustomAgent()">+ Свой агент (.md)</button>
      </div>
    </fieldset>

    <input type="hidden" name="team_config" id="team-config" value="">

    <button type="submit">Создать конфигурацию</button>
  </form>

  <script>
    (function () {
      var allModels = [
        {% for m in (available_models or []) %}
        "{{ m }}"{% if not loop.last %},{% endif %}
        {% endfor %}
      ];

      window.addRow = function () {
        var tbody = document.getElementById('team-rows');
        var firstRow = tbody.querySelector('.team-row:not(.custom-agent-row)');
        if (!firstRow) return;
        var newRow = firstRow.cloneNode(true);
        newRow.querySelectorAll('select').forEach(function (s) { s.selectedIndex = 0; });
        tbody.appendChild(newRow);
      };

      window.addCustomAgent = function () {
        var tbody = document.getElementById('team-rows');
        var row = document.createElement('tr');
        row.className = 'team-row custom-agent-row';
        // Clone model options from existing select (includes Recent + All groups)
        var modelOptions = document.querySelector('.model-select').innerHTML;
        row.innerHTML =
          '<td>' +
            '<input type="text" name="custom_agent_name" class="agent-input" placeholder="Например: Security Auditor" required>' +
            '<input type="file" name="custom_agent_skill" accept=".md,.txt" class="skill-file" required>' +
            '<input type="hidden" name="custom_agent_content" class="skill-content">' +
          '</td>' +
          '<td><select name="model" class="model-select">' + modelOptions + '</select></td>' +
          '<td><button type="button" class="remove-btn" onclick="removeRow(this)">&times;</button></td>';
        tbody.appendChild(row);

        var fileInput = row.querySelector('.skill-file');
        var hiddenContent = row.querySelector('.skill-content');
        fileInput.addEventListener('change', function (e) {
          var file = e.target.files[0];
          if (!file) return;
          var reader = new FileReader();
          reader.onload = function (ev) {
            hiddenContent.value = ev.target.result;
          };
          reader.readAsText(file);
        });
      };

      window.removeRow = function (button) {
        var row = button.closest('.team-row');
        var tbody = document.getElementById('team-rows');
        if (tbody.querySelectorAll('.team-row').length > 1) {
          row.remove();
        }
      };

      document.getElementById('spec-file').addEventListener('change', function (e) {
        var file = e.target.files[0];
        if (!file) return;
        document.getElementById('spec-filename').value = file.name;
        var reader = new FileReader();
        reader.onload = function (ev) {
          document.getElementById('spec-content').value = ev.target.result;
        };
        reader.readAsText(file);
      });

      document.getElementById('setup-form').addEventListener('submit', function () {
        var rows = document.querySelectorAll('.team-row');
        var team = [];
        rows.forEach(function (row) {
          var agentSelect = row.querySelector('.agent-select');
          var agentInput = row.querySelector('.agent-input');
          var skillFile = row.querySelector('.skill-file');
          var skillContent = row.querySelector('.skill-content');

          if (agentSelect) {
            team.push({
              type: 'default',
              agent: agentSelect.value,
              model: row.querySelector('.model-select').value,
            });
          } else if (agentInput) {
            team.push({
              type: 'custom',
              agent: agentInput.value,
              skill_content: skillContent ? skillContent.value : '',
              skill_filename: skillFile && skillFile.files[0] ? skillFile.files[0].name : '',
              model: row.querySelector('.model-select').value,
            });
          }
        });
        document.getElementById('team-config').value = JSON.stringify(team);
      });
    })();
  </script>
</body>
</html>