---
description: Выбор pipeline для проекта (simple, full, или custom)
required_data_keys: []
optional_data_keys:
  - project_name
  - available_pipelines
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Выбор pipeline — {{ project_name | default("проект") }}</title>
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; max-width: 600px; margin: 40px auto; padding: 0 20px; color: #333; }
    h1 { margin-bottom: 8px; }
    .hint { color: #666; font-size: 14px; margin-bottom: 24px; }
    .option { border: 1px solid #ddd; padding: 16px; margin-bottom: 12px; border-radius: 4px; cursor: pointer; }
    .option:hover { background: #f5f5f5; }
    .option input[type="radio"] { margin-right: 12px; }
    .option strong { font-size: 16px; }
    .option p { margin: 6px 0 0 28px; color: #666; font-size: 14px; }
    .actions { margin-top: 24px; }
    button { padding: 10px 24px; font-size: 16px; background: #1976d2; color: white; border: none; border-radius: 4px; cursor: pointer; }
    button:hover { background: #1565c0; }
  </style>
</head>
<body>
  <h1>Выберите pipeline</h1>
  {% if project_name %}<p class="hint">Проект: {{ project_name }}</p>{% endif %}
  <p class="hint">Pipeline определяет последовательность стадий работы.</p>

  <form action="{{ submit_url }}" method="POST">
    <input type="hidden" name="form_id" value="{{ form_id }}">

    {% set pipelines = available_pipelines or [
        {'id': 'simple', 'title': 'Simple', 'description': 'Базовый pipeline: plan → implement → verify. Подходит для большинства проектов.'},
        {'id': 'full', 'title': 'Full', 'description': 'Расширенный: plan → implement → review → test → verify. С reviewer и tester.'},
        {'id': 'custom', 'title': 'Custom', 'description': 'Указать путь к своему .yaml файлу pipeline.'}
    ] %}

    {% for pipeline in pipelines %}
    <label class="option">
      <input type="radio" name="selected_pipeline" value="{{ pipeline.id }}" required>
      <strong>{{ pipeline.title }}</strong>
      <p>{{ pipeline.description }}</p>
    </label>
    {% endfor %}

    <div class="actions">
      <button type="submit">Submit</button>
    </div>
  </form>
</body>
</html>
