---
description: Выбор LLM модели для каждой выбранной роли
required_data_keys:
  - roles
  - available_models
optional_data_keys:
  - default_model
  - project_name
---
<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <title>Выбор моделей — {{ project_name | default("проект") }}</title>
  <style>
    body { font-family: system-ui, -apple-system, sans-serif; max-width: 600px; margin: 40px auto; padding: 0 20px; color: #333; }
    h1 { margin-bottom: 8px; }
    .hint { color: #666; font-size: 14px; margin-bottom: 24px; }
    .role-group { border: 1px solid #ddd; padding: 16px; margin-bottom: 16px; border-radius: 4px; }
    .role-group h3 { margin: 0 0 12px 0; color: #1976d2; }
    label { display: inline-block; padding: 4px 12px 4px 0; cursor: pointer; }
    .actions { margin-top: 24px; }
    button { padding: 10px 24px; font-size: 16px; background: #1976d2; color: white; border: none; border-radius: 4px; cursor: pointer; }
    button:hover { background: #1565c0; }
  </style>
</head>
<body>
  <h1>Выберите модели для ролей</h1>
  {% if project_name %}<p class="hint">Проект: {{ project_name }}</p>{% endif %}

  <form action="{{ submit_url }}" method="POST">
    <input type="hidden" name="form_id" value="{{ form_id }}">

    {% for role in roles %}
    <div class="role-group">
      <h3>{{ role }}</h3>
      {% for model in available_models %}
      <label>
        <input type="radio" name="model_for_{{ role }}" value="{{ model }}"
          {% if model == (default_model or '') %}checked{% endif %}
          required>
        {{ model }}
      </label>
      {% endfor %}
    </div>
    {% endfor %}

    <div class="actions">
      <button type="submit">Submit</button>
    </div>
  </form>
</body>
</html>
