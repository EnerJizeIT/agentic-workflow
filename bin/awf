#!/usr/bin/env bash
# awf — Agentic Workflow Framework CLI
set -euo pipefail

AWF_VERSION="0.3.9"
FRAMEWORK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIB_DIR="$FRAMEWORK_DIR/lib"
TEMPLATES_DIR="$FRAMEWORK_DIR/templates"

usage() {
    cat <<EOF
awf v${AWF_VERSION} — Agentic Workflow Framework

Usage: awf <command> [options]

Commands:
  init              Initialize .agentic/ in current project
  start             Start the pipeline from the beginning
  continue          Resume an interrupted pipeline
  status            Show current workflow state
  report            Show summary report
  add-role <name>   Generate a template for a new role
  baseline <id>     Create a baseline snapshot
  rollback <id>     Rollback to baseline
  reset             Clean runtime data (inbox/outbox/logs)
  help              Show this message

Examples:
  awf init --template simple
  awf init --template full
  awf start
  awf start --pipeline full-review
  awf start --from-stage review
  awf start --auto
  awf continue
  awf status
  awf report
  awf baseline TODO-0001
  awf rollback TODO-0001

Options for 'start':
  --pipeline <name>    Pipeline to run (default: from config.yaml)
  --from-stage <name>  Start from a specific stage
  --auto               Skip supervisor interactive waits
  --background         Run detached (setsid) — don't block the terminal
  --timeout <seconds>  Agent timeout (default: 3600)
EOF
}

if [[ $# -eq 0 ]]; then
    usage
    exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
    init)
        if command -v python3 &>/dev/null && \
           PYTHONPATH="$FRAMEWORK_DIR" python3 -c "import awf" &>/dev/null 2>&1; then
            export PYTHONPATH="$FRAMEWORK_DIR:${PYTHONPATH:-}"
            exec python3 -m awf init "$@"
        fi
        source "$LIB_DIR/init.sh" "$@"
        ;;
    start)
        # --background: run detached (setsid) so it doesn't block the terminal /
        # get killed when the parent shell exits. Without this, every user hits
        # "awf start hung / was killed".
        if [[ " $* " == *" --background"* ]]; then
            args=()
            for a in "$@"; do [[ "$a" == "--background" ]] || args+=("$a"); done
            mkdir -p .agentic/logs
            LOG=".agentic/logs/awf-start.out"
            setsid awf start "${args[@]}" </dev/null >"$LOG" 2>&1 &
            echo "awf start running in background (PID $!)"
            echo "  log:     $LOG"
            echo "  monitor: awf status   |   tail -f $LOG"
            exit 0
        fi
        if command -v python3 &>/dev/null && \
           PYTHONPATH="$FRAMEWORK_DIR" python3 -c "import awf" &>/dev/null 2>&1; then
            export PYTHONPATH="$FRAMEWORK_DIR:${PYTHONPATH:-}"
            exec python3 -m awf start "$@"
        fi
        source "$LIB_DIR/orchestrator.sh" start "$@" ;;
    continue)
        if command -v python3 &>/dev/null && \
           PYTHONPATH="$FRAMEWORK_DIR" python3 -c "import awf" &>/dev/null 2>&1; then
            export PYTHONPATH="$FRAMEWORK_DIR:${PYTHONPATH:-}"
            exec python3 -m awf continue "$@"
        fi
        source "$LIB_DIR/orchestrator.sh" continue "$@" ;;
    status)
        if command -v python3 &>/dev/null && \
           PYTHONPATH="$FRAMEWORK_DIR" python3 -c "import awf" &>/dev/null 2>&1; then
            export PYTHONPATH="$FRAMEWORK_DIR:${PYTHONPATH:-}"
            exec python3 -m awf status "$@"
        fi
        source "$LIB_DIR/status.sh" "$@"
        ;;
    report)
        if command -v python3 &>/dev/null && \
           PYTHONPATH="$FRAMEWORK_DIR" python3 -c "import awf" &>/dev/null 2>&1; then
            export PYTHONPATH="$FRAMEWORK_DIR:${PYTHONPATH:-}"
            exec python3 -m awf report "$@"
        fi
        source "$LIB_DIR/report.sh" "$@"
        ;;
    add-role)
        if command -v python3 &>/dev/null && \
           PYTHONPATH="$FRAMEWORK_DIR" python3 -c "import awf" &>/dev/null 2>&1; then
            export PYTHONPATH="$FRAMEWORK_DIR:${PYTHONPATH:-}"
            exec python3 -m awf add-role "$@"
        fi
        source "$LIB_DIR/add-role.sh" "$@"
        ;;
    baseline)
        if command -v python3 &>/dev/null && \
           PYTHONPATH="$FRAMEWORK_DIR" python3 -c "import awf" &>/dev/null 2>&1; then
            export PYTHONPATH="$FRAMEWORK_DIR:${PYTHONPATH:-}"
            exec python3 -m awf baseline "$@"
        fi
        source "$LIB_DIR/baseline.sh" "$@"
        ;;
    rollback)
        if command -v python3 &>/dev/null && \
           PYTHONPATH="$FRAMEWORK_DIR" python3 -c "import awf" &>/dev/null 2>&1; then
            export PYTHONPATH="$FRAMEWORK_DIR:${PYTHONPATH:-}"
            exec python3 -m awf rollback "$@"
        fi
        source "$LIB_DIR/rollback.sh" "$@"
        ;;
    reset)
        if command -v python3 &>/dev/null && \
           PYTHONPATH="$FRAMEWORK_DIR" python3 -c "import awf" &>/dev/null 2>&1; then
            export PYTHONPATH="$FRAMEWORK_DIR:${PYTHONPATH:-}"
            exec python3 -m awf reset "$@"
        fi
        source "$LIB_DIR/reset.sh" "$@"
        ;;
    help|--help|-h) usage ;;
    *) echo "Unknown command: $COMMAND"; echo "Run 'awf help' for usage."; exit 1 ;;
esac
