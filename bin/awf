#!/usr/bin/env bash
# awf — Agentic Workflow Framework CLI
#
# Thin bash wrapper around the Python core (the `awf` package).
# All command logic lives in awf/cli.py. This file just resolves the framework
# directory and execs python3.
#
# Path resolution: uses python3's os.path.realpath (cross-platform: Linux,
# macOS, BSD). Resolves symlinks so installing via `ln -s` "just works" —
# this is the fix for issue #1. The AWF_FRAMEWORK_DIR env var provides an
# escape hatch for users who `cp bin/awf` somewhere else and remove the
# source tree.
set -euo pipefail

AWF_VERSION="0.4.0"

if ! command -v python3 &>/dev/null; then
    echo "ERROR: awf requires python3 on PATH." >&2
    exit 1
fi

# Resolve the framework root: env override > realpath of this script's parent.
SCRIPT_PATH="${BASH_SOURCE[0]}"
AWF_FRAMEWORK_DIR="${AWF_FRAMEWORK_DIR:-$(python3 -c "
import os, sys
script = sys.argv[1]
# Resolve all symlinks; then go up two levels (bin/awf -> repo root).
real = os.path.realpath(script)
print(os.path.dirname(os.path.dirname(real)))
" "$SCRIPT_PATH")}"

export PYTHONPATH="$AWF_FRAMEWORK_DIR:${PYTHONPATH:-}"

# Delegate to the Python entry point. `exec` replaces this process so signals
# (Ctrl-C etc.) propagate to python directly.
exec python3 -m awf "$@"
