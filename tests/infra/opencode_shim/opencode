#!/usr/bin/env bash
# tests/infra/opencode_shim/opencode — scenario-driven `opencode` shim (NEG-4).
#
# Deterministic stand-in for the real opencode CLI so the subprocess
# container of the engine (spawn, signal watch, salvage, kill) can be
# tested without a real opencode/qwen process. Unlike tests/stubs/opencode
# (one fixed behavior per run) this shim is scenario-driven: the test
# switches the behavior BETWEEN engine invocations via env vars, and every
# invocation is traced to a state dir so a test can assert how the engine
# called the shim and with which mode.
#
# Invocation contract (awf/agent_stage.py::run_agent_stage,
# awf/supervisor.py::run_supervisor_via_subprocess):
#   opencode run --auto [--print-logs] --agent <name> --title <title>
#                [--model <model>] --file <f1> [--file <f2> ...] -- <prompt>
#
# Call distinction — the --title value:
#   worker     : awf-<role>-<TODO-NNNN>   (e.g. awf-worker-TODO-0001)
#   supervisor : awf-supervisor-<kind>    (e.g. awf-supervisor-verify)
# The TODO id comes from the title (worker calls) or from the prompt text
# (supervisor calls — build_prompt embeds "TODO TODO-NNNN"). All --file
# arguments are ignored; the prompt is read only for the TODO id.
#
# Env controls:
#   AWF_SHIM_MODE            worker mode (default: silent-exit)
#     silent-exit    exit 0, write no signal (salvage trigger)
#     crash          exit 3, write no signal (loud failure)
#     hang           spawn `sleep AWF_SHIM_HANG_SECONDS` as a child and
#                    wait — outlives any sane --timeout so the hard-timeout
#                    kill of the process group is exercised for real
#     do-step        leave work (src/ file + PROGRESS) and write the
#                    DONE signal (the "success" mode for a retry)
#     write-blocked  write the BLOCKED signal, exit 0
#   AWF_SHIM_SUPERVISOR_MODE supervisor mode (default derived from the
#                    title kind: approve for verify, plan-todo for
#                    plan/replan, noop otherwise)
#     approve        write .agentic/inbox/ACK-<todo>.ready
#     reject         write .agentic/outbox/REVIEW-<todo>.md
#     plan-todo      create .agentic/inbox/TODO-<AWF_SHIM_PLAN_TODO_ID>.md
#                    + .ready (default id: TODO-0001)
#     noop           exit 0, write nothing
#   AWF_SHIM_STATE_DIR       optional dir for the invocation trace:
#     invocation.log  "<pid> <kind> <mode> <title> <todo>" — one line per
#                     invocation (append; the test passes a fresh dir per
#                     engine run)
#     hang-pids       "<main pid>\n<child pid>" — written by hang mode
#                     before it starts waiting (the test checks both are
#                     dead after the engine's hard-timeout kill)
#     prompt-<N>-<kind>.txt
#                     the full prompt argument of the N-th invocation
#                     (N = invocation.log line number) — ORCH M3.2: lets a
#                     test assert what the engine actually sent to the
#                     stage (task/input/output in the execute prompt)
#   AWF_SHIM_HANG_SECONDS    hang mode sleep length (default 300)
#   AWF_SHIM_PLAN_TODO_ID    plan-todo mode TODO id (default TODO-0001)
#
# The engine spawns us with cwd = project dir, so .agentic/ is relative.
set -euo pipefail

TITLE=""
PROMPT=""
prev=""
seen_dd=false
for arg in "$@"; do
    if [[ "$prev" == "--title" ]]; then
        TITLE="$arg"
    fi
    if [[ "$arg" == "--" ]]; then
        seen_dd=true
        prev=""
        continue
    fi
    if $seen_dd; then
        PROMPT+="${arg} "
    fi
    prev="$arg"
done

TODO_ID=""
if [[ "$TITLE" =~ (TODO-[0-9]+) ]]; then
    TODO_ID="${BASH_REMATCH[1]}"
elif [[ "$PROMPT" =~ (TODO-[0-9]+) ]]; then
    TODO_ID="${BASH_REMATCH[1]}"
fi
[[ -z "$TODO_ID" ]] && TODO_ID="TODO-0000"

KIND="worker"
WORKER_MODE="${AWF_SHIM_MODE:-silent-exit}"
SUP_MODE="${AWF_SHIM_SUPERVISOR_MODE:-}"
SUP_KIND=""
if [[ "$TITLE" == awf-supervisor-* ]]; then
    KIND="supervisor"
    SUP_KIND="${TITLE#awf-supervisor-}"
    if [[ -z "$SUP_MODE" ]]; then
        case "$SUP_KIND" in
            verify) SUP_MODE="approve" ;;
            plan | replan) SUP_MODE="plan-todo" ;;
            *) SUP_MODE="noop" ;;
        esac
    fi
fi

# ORCH M4.4: per-stage identity, resolved from the execute prompt the engine
# sends. stage_id comes from the "Stage identity" block (always present in an
# agent-stage prompt); the declared output from the "Stage assignment" block
# (present when the stage declares a task). Both are engine-controlled
# strings, so the shim can act on them without a per-stage env map. Empty for
# supervisor invocations and for stages that declare neither.
STAGE_ID=$(printf '%s\n' "$PROMPT" | grep -oE 'stage_id="[^"]+"' | head -n1 | sed 's/stage_id="//; s/"$//' || true)
DECLARED_OUTPUT=$(printf '%s\n' "$PROMPT" | grep -oE 'Expected output: [^ ]+' | head -n1 | sed 's/Expected output: //' || true)

# Per-stage worker mode: AWF_SHIM_STAGE_MODES="id1=mode1,id2=mode2" picks the
# mode by the stage's id — one role repeated with different ids needs
# different behavior per instance. Unset, or an id with no entry, falls back
# to the global AWF_SHIM_MODE (back-compat: the existing suite is unchanged).
EFFECTIVE_MODE="$WORKER_MODE"
if [[ -n "$STAGE_ID" && -n "${AWF_SHIM_STAGE_MODES:-}" ]]; then
    for _entry in ${AWF_SHIM_STAGE_MODES//,/ }; do
        if [[ "$_entry" == "${STAGE_ID}="* ]]; then
            EFFECTIVE_MODE="${_entry#*=}"
            break
        fi
    done
fi

STATE_DIR="${AWF_SHIM_STATE_DIR:-}"
if [[ -n "$STATE_DIR" ]]; then
    mkdir -p "$STATE_DIR"
    ACTIVE_MODE="$EFFECTIVE_MODE"
    [[ "$KIND" == "supervisor" ]] && ACTIVE_MODE="$SUP_MODE"
    echo "$$ $KIND $ACTIVE_MODE $TITLE $TODO_ID" >> "$STATE_DIR/invocation.log"
    if [[ -n "$PROMPT" ]]; then
        N=$(wc -l < "$STATE_DIR/invocation.log" | tr -d '[:space:]')
        printf '%s\n' "$PROMPT" > "$STATE_DIR/prompt-${N}-${KIND}.txt"
    fi
fi

INBOX=".agentic/inbox"
OUTBOX=".agentic/outbox"
mkdir -p "$INBOX" "$OUTBOX"

write_done() {
    cat > "$OUTBOX/DONE-${TODO_ID}.md" <<EOF
# DONE-${TODO_ID} (shim do-step)
Simulated work completed; DONE signal written per scenario.
EOF
    touch "$OUTBOX/DONE-${TODO_ID}.ready"
}

write_blocked() {
    cat > "$OUTBOX/BLOCKED-${TODO_ID}.md" <<EOF
# BLOCKED-${TODO_ID} (shim)
Simulated block reason: scenario write-blocked mode.
EOF
    touch "$OUTBOX/BLOCKED-${TODO_ID}.ready"
}

do_step_work() {
    mkdir -p src
    echo "shim work for ${TODO_ID}" > "src/shim-${TODO_ID}-work.txt"
    # ORCH M4.4: the stage's declared output (from the prompt's "Expected
    # output:" line) is the stage's contract. Created (project-relative) only
    # when AWF_SHIM_CREATE_DECLARED_OUTPUT=1 — the e2e composition scenarios
    # opt in so the engine's output check (exists + fresh) passes. Off by
    # default: the negative scenarios (test_stage_assignment_outputs) rely on
    # the declared output being ABSENT to prove DONE alone does not advance.
    if [[ -n "$DECLARED_OUTPUT" && "${AWF_SHIM_CREATE_DECLARED_OUTPUT:-0}" == "1" ]]; then
        mkdir -p "$(dirname "$DECLARED_OUTPUT")" 2>/dev/null || true
        printf 'shim output for stage "%s" (TODO %s)\n' "${STAGE_ID:-$TODO_ID}" "$TODO_ID" > "$DECLARED_OUTPUT"
    fi
    {
        echo "## Task 1 · shim step — [x]"
        echo "- Files changed: src/shim-${TODO_ID}-work.txt"
        if [[ -n "$DECLARED_OUTPUT" ]]; then
            echo "- Declared output: ${DECLARED_OUTPUT}"
        fi
        echo "- Verify: true"
    } >> "$OUTBOX/PROGRESS-${TODO_ID}.md"
}

hang_forever() {
    local secs="${AWF_SHIM_HANG_SECONDS:-300}"
    sleep "$secs" &
    local child=$!
    if [[ -n "$STATE_DIR" ]]; then
        printf '%s\n%s\n' "$$" "$child" > "$STATE_DIR/hang-pids"
    fi
    wait "$child"
}

case "$KIND" in
    supervisor)
        case "$SUP_MODE" in
            approve)
                touch "$INBOX/ACK-${TODO_ID}.ready"
                ;;
            reject)
                printf '# REVIEW-%s (shim)\nSimulated rejection.\n' "$TODO_ID" \
                    > "$OUTBOX/REVIEW-${TODO_ID}.md"
                ;;
            plan-todo)
                PLAN_ID="${AWF_SHIM_PLAN_TODO_ID:-TODO-0001}"
                printf '# %s (shim plan)\nSimulated plan TODO.\n' "$PLAN_ID" \
                    > "$INBOX/${PLAN_ID}.md"
                touch "$INBOX/${PLAN_ID}.ready"
                ;;
            noop)
                :
                ;;
            *)
                echo "tests/infra/opencode_shim: unknown AWF_SHIM_SUPERVISOR_MODE=$SUP_MODE" >&2
                exit 1
                ;;
        esac
        exit 0
        ;;
    worker)
        case "$EFFECTIVE_MODE" in
            silent-exit)
                : # intentional no-op: clean exit, no signal
                ;;
            crash)
                exit 3
                ;;
            hang)
                hang_forever
                ;;
            do-step)
                do_step_work
                write_done
                ;;
            write-blocked)
                write_blocked
                ;;
            blocked:*)
                # ORCH M4.4: block the first K invocations of THIS stage id,
                # then do-step. The count file is keyed by stage id, so two
                # instances of the same role never share a counter — this is
                # what drives the per-instance retry-budget scenario.
                _k="${EFFECTIVE_MODE#blocked:}"
                _count_file=""
                [[ -n "$STATE_DIR" ]] && _count_file="$STATE_DIR/blocked-count-${STAGE_ID:-_global}"
                _n=0
                if [[ -n "$_count_file" && -f "$_count_file" ]]; then
                    _n=$(cat "$_count_file" 2>/dev/null || echo 0)
                fi
                _n=${_n:-0}
                _n=$((_n + 1))
                [[ -n "$_count_file" ]] && printf '%s' "$_n" > "$_count_file"
                if [[ "$_n" -le "$_k" ]]; then
                    write_blocked
                else
                    do_step_work
                    write_done
                fi
                ;;
            *)
                echo "tests/infra/opencode_shim: unknown AWF_SHIM_MODE=$EFFECTIVE_MODE" >&2
                exit 1
                ;;
        esac
        ;;
esac

exit 0
